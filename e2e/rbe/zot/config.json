{
  "distSpecVersion": "1.1.0",
  "storage": {
    "rootDirectory": "/var/lib/zot"
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "auth": {
      "htpasswd": {
        "path": "/state/htpasswd"
      }
    },
    "accessControl": {
      "repositories": {
        "rig/**": {
          "anonymousPolicy": [
            "read"
          ],
          "policies": [
            {
              "users": [
                "rig"
              ],
              "actions": [
                "read",
                "create",
                "update"
              ]
            }
          ],
          "defaultPolicy": []
        },
        "rig-private/**": {
          "policies": [
            {
              "users": [
                "rig"
              ],
              "actions": [
                "read",
                "create",
                "update"
              ]
            }
          ],
          "defaultPolicy": []
        }
      },
      "adminPolicy": {
        "users": [
          "rig"
        ],
        "actions": [
          "read",
          "create",
          "update",
          "delete"
        ]
      }
    }
  },
  "log": {
    "level": "info"
  }
}
