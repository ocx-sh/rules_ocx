# Targets of the rig tests (e2e/rbe/tests). Each writes what the test reads back.
load("//tools:direct.bzl", "direct_run")

# The tool of the default group through its launcher.
genrule(
    name = "tool_run",
    outs = ["tool_run.txt"],
    cmd = "$(execpath @tools//:tool) > $@",
    tools = ["@tools//:tool"],
)

# The executor has no network: the default route of the machine the action runs on. Run locally the same
# action reports `yes`, run on an executor `none` (RIG_PROBE only changes the action key between the two runs).
genrule(
    name = "executor_net",
    outs = ["executor_net.txt"],
    cmd = "d=none; while read -r _ dest _; do [ \"$$dest\" = 00000000 ] && d=yes; done < /proc/net/route; " +
          "if [ -r /proc/net/ipv6_route ]; then while read -r dest plen _ _ _ _ _ _ _ iface; do " +
          "[ \"$$dest\" = 00000000000000000000000000000000 ] && [ \"$$plen\" = 00 ] && [ \"$$iface\" != lo ] && d=yes; " +
          "done < /proc/net/ipv6_route; fi; echo default-route=$$d > $@",
)

# Control: an action that does take @ocx_tool as an input.
genrule(
    name = "ocx_input_control",
    outs = ["ocx_input_control.txt"],
    cmd = "test -x $(execpath @ocx_tool//:ocx) && echo has-ocx > $@",
    tools = ["@ocx_tool//:ocx"],
)

# No shell between Bazel and the launcher.
direct_run(
    name = "tool_direct",
    tool = "@tools//:tool",
)

# Control: a launcher that needs /bin/sh.
direct_run(
    name = "sh_direct_control",
    tool = "//tools:sh_launcher.sh",
)

# A wasip1/wasm package as an action input: no launcher exists for it.
genrule(
    name = "wasm_read",
    srcs = ["@wasm_wasip1_wasm//:set"],
    outs = ["wasm_read.txt"],
    cmd = "for f in $(SRCS); do case $$f in *.wasm) od -An -tx1 -N4 $$f;; esac; done > $@",
)

# Every declared link of the links set, as the action sees it.
genrule(
    name = "links_read",
    srcs = ["@links_linux_amd64//:set"],
    outs = ["links_read.txt"],
    cmd = "for f in $(SRCS); do if [ -L $$f ]; then echo \"$$f $$(readlink $$f)\"; fi; done > $@",
)

# Input list of an action over the tools set.
genrule(
    name = "set_inputs",
    srcs = ["@tools_linux_amd64_libc_glibc//:set"],
    outs = ["set_inputs.txt"],
    cmd = "echo $(SRCS) | wc -w > $@",
)

# An entry point that starts its package's binary by bare name.
genrule(
    name = "entry_run",
    outs = ["entry_run.txt"],
    cmd = "$(execpath @entry//:entry-hello) > $@",
    tools = ["@entry//:entry-hello"],
)

# cmake's action finds ccache, which only the group declares; the control is cmake alone.
[genrule(
    name = "cmake_finds_ccache" + suffix,
    outs = ["cmake_finds_ccache" + suffix + ".txt"],
    cmd = "$(execpath " + hub + ") > $@ && (find -L $(execpath " + hub + ").runfiles -name ccache -type f | grep -q . && echo ccache-found || echo ccache-missing) >> $@",
    tools = [hub],
) for suffix, hub in [
    ("", "@build//:cmake"),
    ("_alone", "@cmake_alone//:cmake"),
]]

# BUILD.bazel, its case variant and a nested BUILD stay at their places in the runfiles.
genrule(
    name = "buildfiles_read",
    outs = ["buildfiles_read.txt"],
    cmd = "$(execpath @buildfiles//:tool) > $@ && (cd $(execpath @buildfiles//:tool).runfiles && find -L . \\( -name BUILD.bazel -o -name build -o -name BUILD \\) -type f | LC_ALL=C sort) >> $@",
    tools = ["@buildfiles//:tool"],
)

# The env-template package's tool.
genrule(
    name = "envtpl_run",
    outs = ["envtpl_run.txt"],
    cmd = "$(execpath @envtpl//:envtpl) > $@",
    tools = ["@envtpl"],
)

# A batch of actions over the big set and over the small tools set.
[genrule(
    name = "batch_{}_{}".format(kind, i),
    srcs = [setlabel],
    outs = ["batch_{}_{}.txt".format(kind, i)],
    cmd = "echo {} > $@".format(i),
) for kind, setlabel in [
    ("big", "@big_linux_amd64//:set"),
    ("small", "@tools_linux_amd64_libc_glibc//:set"),
] for i in range(5)]
