# Targets of the rig tests (e2e/rbe/tests). Each writes what the test reads back.
load("//tools:direct.bzl", "direct_run")

# The tool of the default group through its launcher (V-01, V-02, V-06, V-13).
genrule(
    name = "tool_run",
    outs = ["tool_run.txt"],
    cmd = "$(execpath @tools//:tool) > $@",
    tools = ["@tools//:tool"],
)

# Control for V-06: an action that does take @ocx_tool as an input.
genrule(
    name = "ocx_input_control",
    outs = ["ocx_input_control.txt"],
    cmd = "test -x $(execpath @ocx_tool//:ocx) && echo has-ocx > $@",
    tools = ["@ocx_tool//:ocx"],
)

# No shell between Bazel and the launcher (V-07, V-28).
direct_run(
    name = "tool_direct",
    tool = "@tools//:tool",
)

# Control for V-07/V-28: a launcher that needs /bin/sh.
direct_run(
    name = "sh_direct_control",
    tool = "//tools:sh_launcher.sh",
)

# A wasip1/wasm package as an action input: no launcher exists for it (V-08).
genrule(
    name = "wasm_read",
    srcs = ["@wasm_wasip1_wasm//:set"],
    outs = ["wasm_read.txt"],
    cmd = "for f in $(SRCS); do case $$f in *.wasm) od -An -tx1 -N4 $$f;; esac; done > $@",
)

# Every declared link of the links set, as the action sees it (V-12).
genrule(
    name = "links_read",
    srcs = ["@links_linux_amd64//:set"],
    outs = ["links_read.txt"],
    cmd = "for f in $(SRCS); do if [ -L $$f ]; then echo \"$$f $$(readlink $$f)\"; fi; done > $@",
)

# Input list of an action over the tools set (V-34).
genrule(
    name = "set_inputs",
    srcs = ["@tools_linux_amd64_libc_glibc//:set"],
    outs = ["set_inputs.txt"],
    cmd = "echo $(SRCS) | wc -w > $@",
)

# An entry point that starts its package's binary by bare name (V-29, V-30).
genrule(
    name = "entry_run",
    outs = ["entry_run.txt"],
    cmd = "$(execpath @entry//:entry-hello) > $@",
    tools = ["@entry//:entry-hello"],
)

# cmake's action finds ccache, which only the group declares (V-41); the control is cmake alone.
[genrule(
    name = "cmake_finds_ccache" + suffix,
    outs = ["cmake_finds_ccache" + suffix + ".txt"],
    cmd = "$(execpath " + hub + ") > $@ && (find -L $(execpath " + hub + ").runfiles -name ccache -type f | grep -q . && echo ccache-found || echo ccache-missing) >> $@",
    tools = [hub],
) for suffix, hub in [
    ("", "@build//:cmake"),
    ("_alone", "@cmake_alone//:cmake"),
]]

# BUILD.bazel, its case variant and a nested BUILD stay at their places in the runfiles (V-47).
genrule(
    name = "buildfiles_read",
    outs = ["buildfiles_read.txt"],
    cmd = "$(execpath @buildfiles//:tool) > $@ && (cd $(execpath @buildfiles//:tool).runfiles && find -L . \\( -name BUILD.bazel -o -name build -o -name BUILD \\) -type f | LC_ALL=C sort) >> $@",
    tools = ["@buildfiles//:tool"],
)

# The env-template package's tool (V-25).
genrule(
    name = "envtpl_run",
    outs = ["envtpl_run.txt"],
    cmd = "$(execpath @envtpl//:envtpl) > $@",
    tools = ["@envtpl"],
)

# A batch of actions over the big set and over the small tools set (V-31).
[genrule(
    name = "batch_{}_{}".format(kind, i),
    srcs = [setlabel],
    outs = ["batch_{}_{}.txt".format(kind, i)],
    cmd = "echo {} > $@".format(i),
) for kind, setlabel in [
    ("big", "@big_linux_amd64//:set"),
    ("small", "@tools_linux_amd64_libc_glibc//:set"),
] for i in range(5)]
