# Execution platforms the cases select with --extra_execution_platforms.
# The rig has one executor architecture; the leaves differ only in what they report.

platform(
    name = "exec_glibc",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@rules_ocx//ocx/constraints:glibc",
    ],
)

platform(
    name = "exec_musl",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@rules_ocx//ocx/constraints:musl",
    ],
)

# Matches no toolchain of any hub.
platform(
    name = "exec_none",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:freebsd",
    ],
)
