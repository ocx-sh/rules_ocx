"""BCR presubmit test module — consumes rules_ocx as a downstream Bazel module.

Build-only smoke test. It vendors one digest-pinned package for the host and
builds its tool, which proves that a downstream consumer gets the pinned `ocx`
CLI, the hub with its toolchains and one runnable set. `../..` resolves to the
module under test: BCR checks out the whole release archive and runs this
module in place at e2e/bzlmod.
"""

module(name = "rules_ocx_e2e_bzlmod")

bazel_dep(name = "rules_ocx", version = "0.0.0")
local_path_override(
    module_name = "rules_ocx",
    path = "../..",
)

ocx = use_extension("@rules_ocx//ocx:extensions.bzl", "ocx")

# Digest-pinned, so the extension records a fact and the result does not move.
ocx.package(
    name = "jq",
    package = "ocx.sh/jqlang/jq:latest@sha256:c295300441831e002c0ba54df8e6126cdd4064c63be2464bdc6b68d0012beec6",
    platforms = [
        "darwin/amd64",
        "darwin/arm64",
        "linux/amd64",
        "linux/arm64",
        "windows/amd64",
    ],
)
use_repo(ocx, "jq")

register_toolchains("@jq//:all")
