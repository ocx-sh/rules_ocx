# rules_ocx developer defaults. Keep minimal — consumers set their own flags.
# Shared baseline: remote cache, --config=ci/basic/deep, .bazelrc.user (template-owned).
import %workspace%/bazel/baseline.bazelrc

common --enable_platform_specific_config

# Windows: sh_test data needs a real runfiles tree, not just a manifest.
startup --windows_enable_symlinks
common:windows --enable_runfiles

build --incompatible_disallow_empty_glob
test --test_output=errors

# Repo rules talk to the shared OCX_HOME and the ocx.sh registry; keep their
# env visible to fetches (getenv() declarations in the rules do the tracking).

# Developer-local overrides; must stay the last line (baseline contract C-012).
try-import %workspace%/.bazelrc.user
