{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly"
  ],
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "description": "GitHub Actions — group, SHA-pin, ci(deps) prefix",
      "matchManagers": ["github-actions"],
      "groupName": "actions",
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps",
      "pinDigests": true
    },
    {
      "description": "Bazel module deps — group, chore(deps) prefix",
      "matchManagers": ["bazel-module"],
      "groupName": "bazel-deps",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Site npm deps — group, chore(deps) prefix",
      "matchManagers": ["npm"],
      "groupName": "site-deps",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Theme and deploy action move together: the action aborts when its Pagefind differs from the theme's",
      "matchPackageNames": ["@ocx-sh/theme", "ocx-sh/website/.github/actions/deploy"],
      "groupName": "ocx-theme",
      "semanticCommitType": "build",
      "semanticCommitScope": "site"
    }
  ]
}
