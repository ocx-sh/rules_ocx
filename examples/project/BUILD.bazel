# Every tool of the lock is a runnable target in @tools: shell tooling
# composed in a genrule report plus an sh_test.

load("@rules_shell//shell:sh_test.bzl", "sh_test")

genrule(
    name = "shell_report",
    srcs = ["smelly.sh"],
    outs = ["shell_report.txt"],
    cmd = "echo shfmt: > $@ && (($(location @tools//:shfmt) -d $< 2>> $@) || true) && " +
          "echo shellcheck: >> $@ && (($(location @tools//:shellcheck) $< >> $@) || true)",
    tools = [
        "@tools//:shellcheck",
        "@tools//:shfmt",
    ],
)

sh_test(
    name = "tools_test",
    size = "small",
    srcs = ["tools_test.sh"],
    data = [
        ":shell_report",
        "@shellcheck_version//:version.txt",
        "@tools//:shellcheck",
        "@tools//:shfmt",
    ],
    env = {
        "FETCH_VERSION": "$(rlocationpath @shellcheck_version//:version.txt)",
        "REPORT": "$(rlocationpath :shell_report)",
        "SHELLCHECK_BIN": "$(rlocationpath @tools//:shellcheck)",
        "SHFMT_BIN": "$(rlocationpath @tools//:shfmt)",
    },
    deps = ["@rules_shell//shell/runfiles"],
)
