"""Example: one package vendored for several platforms, behind one hub."""

module(name = "rules_ocx_example_cross_platform")

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_ocx", version = "0.0.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

local_path_override(
    module_name = "rules_ocx",
    path = "../..",
)

ocx = use_extension("@rules_ocx//ocx:extensions.bzl", "ocx")

# ':latest' resolves frozen from the committed index snapshot in index/ —
# every platform repo sees the same resolution. Refresh with
# `ocx --index index index update ocx.sh/jqlang/jq` and commit.
ocx.package(
    name = "jq",
    index = "//:index",
    package = "ocx.sh/jqlang/jq:latest",
    platforms = [
        "darwin/amd64",
        "darwin/arm64",
        "linux/amd64",
        "linux/arm64",
        "windows/amd64",
    ],
)

# The hub holds one toolchain per platform. A tool of the hub runs on the
# platform an action executes on.
register_toolchains("@jq//:all")

# The set repositories of the platforms this example inspects without running:
# a foreign platform's files are reachable as `@jq_<os>_<arch>//:set`.
use_repo(
    ocx,
    "jq",
    "jq_linux_arm64",
    "jq_windows_amd64",
)
