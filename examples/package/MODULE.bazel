"""Example: ad-hoc OCX packages via ocx.package()."""

module(name = "rules_ocx_example_package")

bazel_dep(name = "rules_ocx", version = "0.0.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

local_path_override(
    module_name = "rules_ocx",
    path = "../..",
)

ocx = use_extension("@rules_ocx//ocx:extensions.bzl", "ocx")

# The build's weakening posture, at its defaults: a no-op that exercises the
# tag class end to end. Root module only; at most one.
ocx.policy()

# `platforms` is required: it names every platform a build may run the tool on.
# A build fetches only the set of the platform it executes on.

# Floating tag: resolves each time the extension runs, so it records no fact
# and the extension is not reproducible. Use it to try a package out.
ocx.package(
    name = "jq",
    package = "ocx.sh/jqlang/jq:latest",
    platforms = [
        "darwin/amd64",
        "darwin/arm64",
        "linux/amd64",
        "linux/arm64",
        "windows/amd64",
    ],
)

# Frozen index: ':latest' resolves from the committed snapshot in index/
# (created with `ocx --index index index update ocx.sh/jqlang/jq`) — OCX's
# native tag locking. Deterministic until the snapshot is refreshed and committed.
ocx.package(
    name = "jq_frozen",
    index = "//:index",
    package = "ocx.sh/jqlang/jq:latest",
    platforms = [
        "darwin/amd64",
        "darwin/arm64",
        "linux/amd64",
        "linux/arm64",
        "windows/amd64",
    ],
)

# Digest-pinned: fully reproducible. The extension records what the package
# provides in MODULE.bazel.lock and runs no ocx on the next resolution.
ocx.package(
    name = "jq_pinned",
    package = "ocx.sh/jqlang/jq:latest@sha256:c295300441831e002c0ba54df8e6126cdd4064c63be2464bdc6b68d0012beec6",
    platforms = [
        "darwin/amd64",
        "darwin/arm64",
        "linux/amd64",
        "linux/arm64",
        "windows/amd64",
    ],
)

register_toolchains(
    "@jq//:all",
    "@jq_frozen//:all",
    "@jq_pinned//:all",
)

use_repo(ocx, "jq", "jq_frozen", "jq_pinned")
