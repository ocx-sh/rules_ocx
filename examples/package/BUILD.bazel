# Provisioned tools as `tools =` of a genrule and as `data =` of an sh_test,
# read through the runfiles library so the test also runs on Windows without
# `--enable_runfiles`.

load("@rules_shell//shell:sh_test.bzl", "sh_test")

genrule(
    name = "pretty",
    srcs = ["data.json"],
    outs = ["pretty.json"],
    cmd = "$(location @jq//:jq) . $< > $@",
    tools = ["@jq"],
)

sh_test(
    name = "jq_test",
    size = "small",
    srcs = ["jq_test.sh"],
    data = [
        ":pretty",
        "@jq",
        "@jq_frozen//:jq",
        "@jq_pinned//:jq",
    ],
    env = {
        "JQ_BIN": "$(rlocationpath @jq//:jq)",
        "JQ_FROZEN_BIN": "$(rlocationpath @jq_frozen//:jq)",
        "JQ_PINNED_BIN": "$(rlocationpath @jq_pinned//:jq)",
        "PRETTY_JSON": "$(rlocationpath :pretty)",
    },
    deps = ["@rules_shell//shell/runfiles"],
)
