        package.args,
    )

    rooted = vendor_args(struct(
        tier = "project",
        out = "out",
        platform = "linux/amd64",
        groups = [],
        bindings = [],
        package = "",
        project = "/w/ocx.toml",
        index = "/w/index",
        blob_dirs = ["/w/b1", "/w/b2"],
