def _set_analysis_impl(ctx):
    env = analysistest.begin(ctx)
    target = analysistest.target_under_test(env)
    runfiles = [f.short_path for f in target[DefaultInfo].default_runfiles.files.to_list()]
    for path in ["lib/real.txt", "share", "bin/foo.exe", "bin/foo.exe.launch", "_ocx_reserved/0"]:
        asserts.true(env, _SET + path in runfiles, "runfiles hold " + path)

    # Declared in this package, never through root_symlinks of another repository.
    asserts.true(env, _SET + "lib/alias.txt" in runfiles, "the declared link")
    asserts.true(env, _SET + "lib/BUILD" in runfiles, "the reserved file restored at its original path")
    outputs = {o.short_path: a.mnemonic for a in analysistest.target_actions(env) for o in a.outputs.to_list()}
    asserts.equals(env, "UnresolvedSymlink", outputs.get(_SET + "lib/alias.txt"))
    asserts.equals(env, "Symlink", outputs.get(_SET + "lib/BUILD"))
    info = target[OcxSetInfo]
    asserts.equals(env, ["foo.exe"], info.tools.keys())
    asserts.equals(env, _SET + "bin/foo.exe", info.tools["foo.exe"].launcher.short_path)
    asserts.equals(env, _SET + "bin/foo.exe.launch", info.tools["foo.exe"].record.short_path)
    asserts.true(env, _SET + "lib/alias.txt" in [f.short_path for f in info.files.to_list()])
    return analysistest.end(env)

def _tool_analysis_impl(ctx):
    env = analysistest.begin(ctx)
    target = analysistest.target_under_test(env)
    asserts.equals(env, ["ocx/tests/foo.exe", "ocx/tests/foo.exe.launch"], sorted([f.short_path for f in target[DefaultInfo].files.to_list()]), "both links in the tool's own package")
    asserts.equals(env, "ocx/tests/foo.exe", target[DefaultInfo].files_to_run.executable.short_path)
    runfiles = [f.short_path for f in target[DefaultInfo].default_runfiles.files.to_list()]
    for path in [_SET + "lib/real.txt", _SET + "lib/alias.txt", _SET + "bin/foo.exe.launch", "ocx/tests/foo.exe.launch"]:
        asserts.true(env, path in runfiles, "the tool carries the set's runfiles: " + path)
    return analysistest.end(env)

_set_analysis_test = analysistest.make(_set_analysis_impl)
_tool_analysis_test = analysistest.make(
    _tool_analysis_impl,
    config_settings = {"//command_line_option:extra_toolchains": [str(Label("//ocx/tests:set_repo_tests_tc"))]},
)

def set_repo_test_suite(name):
    """Instantiates the set_repo.bzl test suite.

    Args:
        name: name of the test suite target.
    """
    ocx_set(
        name = name + "_set",
        srcs = [
            ":testdata/set/lib/real.txt",
            ":testdata/set/share",
            ":testdata/set/bin/foo.exe",
            ":testdata/set/bin/foo.exe.launch",
            ":testdata/set/_ocx_reserved/0",
        ],
        links = {"testdata/set/lib/alias.txt": "real.txt"},
        reserved = {"testdata/set/_ocx_reserved/0": "testdata/set/lib/BUILD"},
        tools = {"foo.exe": ["testdata/set/bin/foo.exe", "testdata/set/bin/foo.exe.launch"]},
        tags = ["manual"],
    )
    ocx_set_toolchain(name = name + "_impl", set = ":" + name + "_set", tags = ["manual"])
    native.toolchain_type(name = name + "_type")
    native.toolchain(name = name + "_tc", toolchain_type = ":" + name + "_type", toolchain = ":" + name + "_impl")
    _test_tool(name = name + "_tool", tool = "foo.exe", tags = ["manual"])
    _set_analysis_test(name = name + "_set_analysis_test", target_under_test = ":" + name + "_set")
    _tool_analysis_test(name = name + "_tool_analysis_test", target_under_test = ":" + name + "_tool")
    unittest.suite(
        name + "_unit",
        reserved_moves_test,
        build_file_test,
        build_file_golden_test,
        build_file_reserved_test,
        build_file_quoting_test,
        cross_check_test,
        tool_conflict_test,
        pinned_test,
        failure_test,
        windows_link_test,
        vendor_args_test,
        isolated_env_test,
        root_digest_test,
        empty_expected_test,
        vendor_argv_kinds_test,
        vendor_identifier_test,
    )
    native.test_suite(
        name = name,
        tests = [":" + name + "_unit", ":" + name + "_set_analysis_test", ":" + name + "_tool_analysis_test"],
    )
