def _build_file_golden_test_impl(ctx):
    env = unittest.begin(ctx)
    asserts.equals(env, _GOLDEN, build_file_content(_manifest(), []))
    return unittest.end(env)

def _build_file_reserved_test_impl(ctx):
    env = unittest.begin(ctx)

    # A reserved file inside the link-free directory: that directory drops its
    # label, its other files get file labels, and the moved file is restored.
    def mutate(raw):
        tree = raw["packages"][0]["tree"]
        tree["files"] += [
            {"path": _PKG + "/content/share/BUILD", "executable": False},
            {"path": _PKG + "/content/share/a.txt", "executable": False},
            {"path": _PKG + "/content/bin/build", "executable": False},
        ]

    manifest = _manifest(_mutated(mutate))
    moves = reserved_moves(manifest).moves
    asserts.equals(env, [
        struct(src = _PKG + "/content/share/BUILD", dst = "_ocx_reserved/0"),
        struct(src = _PKG + "/content/bin/build", dst = "_ocx_reserved/1"),
    ], moves, "manifest order, ASCII case-insensitive")
    content = build_file_content(manifest, moves)
    asserts.false(env, '":' + _PKG + '/content/share",' in content, "no directory label over a reserved name")
    asserts.true(env, '":' + _PKG + '/content/share/a.txt",' in content)
    asserts.false(env, '":' + _PKG + '/content/share/BUILD",' in content, "the moved file is not a source")
    asserts.true(env, '"_ocx_reserved/0": "' + _PKG + '/content/share/BUILD",' in content)
    return unittest.end(env)

def _build_file_quoting_test_impl(ctx):
    env = unittest.begin(ctx)

    # An apostrophe is label-safe and must survive the quoting; a double quote
    # never reaches it, the parser refuses it.
    odd = _PKG + "/content/bin/a'b $x"
    manifest = _manifest(_mutated(lambda raw: raw["packages"][0]["tree"]["files"][0].update({"path": odd})))
    asserts.true(env, manifest != None, "the example with an odd name parses")
    asserts.true(env, '":' + odd + '",' in build_file_content(manifest, []))
    return unittest.end(env)

def _pinned_test_impl(ctx):
    env = unittest.begin(ctx)
    digest = "1f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a7988"
    asserts.true(env, package_pinned("ocx.sh/a/b:1@sha256:" + digest))
    asserts.false(env, package_pinned("ocx.sh/a/b:1"))
    asserts.false(env, package_pinned("ocx.sh/a/b:1@sha256:"), "no digest")
    asserts.false(env, package_pinned("ocx.sh/a/b:1@sha256:abc"), "short digest")
    asserts.false(env, package_pinned("ocx.sh/a/b:1@sha256:" + digest.upper()), "uppercase")
    return unittest.end(env)

def _failure_test_impl(ctx):
    env = unittest.begin(ctx)
    asserts.equals(env, "", vendor_failure(["vendor"], 0, ""))
    text = vendor_failure(["vendor", "-o", "x"], 65, "lock out of date\n")
    asserts.true(env, "exit 65" in text and "lock out of date" in text and "ocx lock" in text, text)
    asserts.true(env, vendor_failure(["vendor"], 2, "") != "", "an unmapped code still fails")
    return unittest.end(env)

def _cross_check_test_impl(ctx):
    env = unittest.begin(ctx)
    m = _manifest()
    ok = struct(platform = m.platform, tools = [["cmake", "binary"]], available_platforms = m.available_platforms)
    asserts.equals(env, "", cross_check(m, ok))
    tampered = struct(platform = m.platform, tools = [["cmak3", "binary"]], available_platforms = m.available_platforms)
    asserts.true(env, "bazel mod deps --lockfile_mode=update" in cross_check(m, tampered))
    kind = struct(platform = m.platform, tools = [["cmake", "entrypoint"]], available_platforms = m.available_platforms)
    asserts.true(env, "bazel mod deps --lockfile_mode=update" in cross_check(m, kind), "a kind difference")
    platforms = struct(platform = m.platform, tools = [["cmake", "binary"]], available_platforms = ["darwin/arm64"])
    asserts.true(env, "bazel mod deps --lockfile_mode=update" in cross_check(m, platforms), "available_platforms difference")
    unsorted = struct(platform = m.platform, tools = [["cmake", "binary"]], available_platforms = list(reversed(m.available_platforms)))
    asserts.equals(env, "", cross_check(m, unsorted), "order is not part of the fact")

    # The manifest must be for the platform asked for, not the one it claims.
    other = struct(platform = "darwin/arm64", tools = [["cmake", "binary"]], available_platforms = m.available_platforms)
    asserts.true(env, "darwin/arm64" in cross_check(m, other) and m.platform in cross_check(m, other), "a manifest for another platform")

    # An empty record is a record: a manifest holding tools disagrees with it.
    empty = struct(platform = m.platform, tools = [], available_platforms = [])
    asserts.true(env, cross_check(m, empty) != "", "empty expectations are still checked")
    return unittest.end(env)

def _tool_conflict_test_impl(ctx):
    env = unittest.begin(ctx)
    asserts.equals(env, "", tool_conflict_error(_manifest()), "control: one selection")

    def second(target_path):
        def mutate(raw):
            raw["selections"].append(dict(raw["selections"][0], id = "extra"))
            raw["tools"].append(dict(raw["tools"][0], selection = "extra", target_path = target_path, launcher_path = "selections/extra/shells/default/bin/cmake"))

        return tool_conflict_error(_manifest(_mutated(mutate)))

    err = second(_PKG + "/content/bin/other")
    asserts.true(env, "cmake" in err and "'default'" in err and "'extra'" in err, "names the tool and both selections: " + err)
    asserts.equals(env, "", second(_PKG + "/content/bin/cmake"), "the same target twice is not a conflict")
    return unittest.end(env)

def _windows_link_test_impl(ctx):
    env = unittest.begin(ctx)
    win = EXAMPLE.replace('"platform": "linux/amd64+libc.glibc"', '"platform": "windows/amd64"')
    err = windows_link_error(_manifest(win))
    asserts.true(env, "sha256:1f2e3d4c" in err or "cmake" in err, "names the package")
    asserts.equals(env, "", windows_link_error(_manifest()), "linux keeps its links")
    no_links = win.replace('"links": [{"path": "' + _PKG + '/content/bin/cmake3", "target": "cmake"}]', '"links": []')
    asserts.equals(env, "", windows_link_error(_manifest(no_links)))
    return unittest.end(env)

def _vendor_args_test_impl(ctx):
    env = unittest.begin(ctx)
    project = vendor_args(struct(
        tier = "project",
        out = "out",
        platform = "linux/amd64",
        groups = ["a", "b"],
        bindings = ["cmake", "ninja"],
        package = "",
    ))
    asserts.equals(env, "", project.error)
    asserts.equals(
        env,
        ["--format", "json", "vendor", "-o", "out", "-p", "linux/amd64", "--omit-links", "-g", "a", "-g", "b", "cmake", "ninja"],
        project.args,
    )
    package = vendor_args(struct(
        tier = "package",
        out = "out",
        platform = "linux/amd64",
        groups = [],
        bindings = [],
        package = "ocx.sh/kitware/cmake:3.31.6",
    ))
    asserts.equals(env, "", package.error)
    asserts.equals(
        env,
        ["--format", "json", "package", "vendor", "-o", "out", "-p", "linux/amd64", "--omit-links", "ocx.sh/kitware/cmake:3.31.6"],
        package.args,
    )

    rooted = vendor_args(struct(
        tier = "project",
        out = "out",
        platform = "linux/amd64",
        groups = [],
        bindings = [],
        package = "",
        project = "/w/ocx.toml",
        index = "/w/index",
        blob_dirs = ["/w/b1", "/w/b2"],
    ))
    asserts.equals(
        env,
        ["--format", "json", "--project", "/w/ocx.toml", "--index", "/w/index", "--blob-dir", "/w/b1", "--blob-dir", "/w/b2", "vendor", "-o", "out", "-p", "linux/amd64", "--omit-links"],
        rooted.args,
        "root flags precede the verb",
    )
    asserts.true(env, vendor_args(struct(tier = "package", out = "o", platform = "p", groups = [], bindings = [], package = "")).error != "")
    return unittest.end(env)

