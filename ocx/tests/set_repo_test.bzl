    asserts.true(env, _PKG + "/share" in content, "link-free directory label")
    asserts.true(env, '":l/cmake.launch",' in content, "the record is a source beside its launcher")
    asserts.true(env, '":p/5a0c1e9d2b7f3a4c/e/npm.launch",' in content, "the entry point record is a source")
    return unittest.end(env)

