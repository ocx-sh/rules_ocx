_PKG = "p/1f2e3d4c5b6a7988/c"
_CMAKE = '{"path": "' + _PKG + '/bin/cmake"'

def _mutated(mutate):
    raw = json.decode(EXAMPLE)
    mutate(raw)
    return json.encode(raw)

def _manifest(text = EXAMPLE):
    return parse_manifest(text).manifest

def _reserved_moves_test_impl(ctx):
    env = unittest.begin(ctx)
    asserts.equals(env, [], reserved_moves(_manifest()).moves)
    text = EXAMPLE.replace(_CMAKE, '{"path": "' + _PKG + '/Build.bazel"')
    moves = reserved_moves(_manifest(text))
    asserts.equals(env, "", moves.error)
    asserts.equals(env, [struct(src = _PKG + "/Build.bazel", dst = "_ocx_reserved/0")], moves.moves)

    # parse_manifest refuses a path outside its package's content directory, so a
    # top-level `_ocx_reserved` entry can only come from a manifest built by hand.
    clashing = struct(
        packages = [],
        selections = [],
        tools = [struct(target_path = "_ocx_reserved/x", launcher_path = None, record_path = "")],
    )
    asserts.true(env, reserved_moves(clashing).error != "", "a top-level _ocx_reserved must be refused")
    asserts.equals(env, "", reserved_moves(struct(packages = [], selections = [], tools = [])).error, "control: no entry, no error")
    asserts.true(env, parse_manifest(EXAMPLE.replace(_CMAKE, '{"path": "_ocx_reserved/x"')).error != "", "the parser refuses it first")
    return unittest.end(env)

def _build_file_test_impl(ctx):
