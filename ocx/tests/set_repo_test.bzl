def _build_file_golden_test_impl(ctx):
    env = unittest.begin(ctx)
    asserts.equals(env, _GOLDEN, build_file_content(_manifest(), []))
    return unittest.end(env)

def _build_file_reserved_test_impl(ctx):
    env = unittest.begin(ctx)

    # A reserved file inside the link-free directory: that directory drops its
    # label, its other files get file labels, and the moved file is restored.
    def mutate(raw):
        tree = raw["packages"][0]["tree"]
        tree["files"] += [
            {"path": _PKG + "/share/BUILD", "executable": False},
            {"path": _PKG + "/share/a.txt", "executable": False},
            {"path": _PKG + "/bin/build", "executable": False},
        ]

    manifest = _manifest(_mutated(mutate))
    moves = reserved_moves(manifest).moves
    asserts.equals(env, [
        struct(src = _PKG + "/share/BUILD", dst = "_ocx_reserved/0"),
        struct(src = _PKG + "/bin/build", dst = "_ocx_reserved/1"),
    ], moves, "manifest order, ASCII case-insensitive")
    content = build_file_content(manifest, moves)
    asserts.false(env, '":' + _PKG + '/share",' in content, "no directory label over a reserved name")
    asserts.true(env, '":' + _PKG + '/share/a.txt",' in content)
    asserts.false(env, '":' + _PKG + '/share/BUILD",' in content, "the moved file is not a source")
    asserts.true(env, '"_ocx_reserved/0": "' + _PKG + '/share/BUILD",' in content)
    return unittest.end(env)

def _build_file_quoting_test_impl(ctx):
    env = unittest.begin(ctx)

    # An apostrophe is label-safe and must survive the quoting; a double quote
    # never reaches it, the parser refuses it.
    odd = _PKG + "/bin/a'b $x"
    manifest = _manifest(_mutated(lambda raw: raw["packages"][0]["tree"]["files"][0].update({"path": odd})))
    asserts.true(env, manifest != None, "the example with an odd name parses")
    asserts.true(env, '":' + odd + '",' in build_file_content(manifest, []))
    return unittest.end(env)

def _pinned_test_impl(ctx):
    env = unittest.begin(ctx)
    digest = "1f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a7988"
    asserts.true(env, package_pinned("ocx.sh/a/b:1@sha256:" + digest))
    asserts.false(env, package_pinned("ocx.sh/a/b:1"))
    asserts.false(env, package_pinned("ocx.sh/a/b:1@sha256:"), "no digest")
    asserts.false(env, package_pinned("ocx.sh/a/b:1@sha256:abc"), "short digest")
    asserts.false(env, package_pinned("ocx.sh/a/b:1@sha256:" + digest.upper()), "uppercase")
    return unittest.end(env)

def _failure_test_impl(ctx):
    env = unittest.begin(ctx)
    asserts.equals(env, "", vendor_failure(["vendor"], 0, ""))
    text = vendor_failure(["vendor", "-o", "x"], 65, "lock out of date\n")
    asserts.true(env, "exit 65" in text and "lock out of date" in text and "ocx lock" in text, text)
    asserts.true(env, vendor_failure(["vendor"], 2, "") != "", "an unmapped code still fails")

    # X6: a failed set fetch of a pinned manifest may mean the registry dropped it.
    head = "hint: the platform manifest MODULE.bazel.lock pins for 'jq' may be gone from the registry; "
    fixes = {"tag": "run bazel mod deps --lockfile_mode=update --repo_env=RULES_OCX_UPDATE=jq", "pinned": "pin another digest in the identifier"}
    for kind, fix in fixes.items():
        asserts.true(env, head + fix in vendor_failure(["vendor"], 69, "unreachable", kind, "jq"), "{}: the X6 hint for exit 69".format(kind))
    asserts.false(env, head in vendor_failure(["vendor"], 65, "no binary", "tag", "jq"), "no hint on exit 65")
    asserts.false(env, head in vendor_failure(["vendor"], 69, "unreachable", "project", "jq"), "no hint under project")
    asserts.false(env, head in vendor_failure(["vendor"], 69, "unreachable", "index", "jq"), "no hint under index")
    return unittest.end(env)

def _cross_check_test_impl(ctx):
    env = unittest.begin(ctx)
    m = _manifest()
    all_tools = [["cmake", "binary"], ["node", "binary"], ["npm", "entrypoint"]]
    ok = struct(platform = m.platform, tools = all_tools, available_platforms = m.available_platforms)
    asserts.equals(env, "", cross_check(m, ok))
    tampered = struct(platform = m.platform, tools = [["cmak3", "binary"], ["node", "binary"], ["npm", "entrypoint"]], available_platforms = m.available_platforms)
    asserts.true(env, "bazel mod deps --lockfile_mode=update" in cross_check(m, tampered))
    kind = struct(platform = m.platform, tools = [["cmake", "entrypoint"], ["node", "binary"], ["npm", "entrypoint"]], available_platforms = m.available_platforms)
    asserts.true(env, "bazel mod deps --lockfile_mode=update" in cross_check(m, kind), "a kind difference")
    platforms = struct(platform = m.platform, tools = all_tools, available_platforms = ["darwin/arm64"])
    asserts.true(env, "bazel mod deps --lockfile_mode=update" in cross_check(m, platforms), "available_platforms difference")
    unsorted = struct(platform = m.platform, tools = all_tools, available_platforms = list(reversed(m.available_platforms)))
    asserts.equals(env, "", cross_check(m, unsorted), "order is not part of the fact")

    # The manifest must be for the platform asked for, not the one it claims.
    other = struct(platform = "darwin/arm64", tools = all_tools, available_platforms = m.available_platforms)
    asserts.true(env, "darwin/arm64" in cross_check(m, other) and m.platform in cross_check(m, other), "a manifest for another platform")

    # An empty record is a record: a manifest holding tools disagrees with it.
    empty = struct(platform = m.platform, tools = [], available_platforms = [])
    asserts.true(env, cross_check(m, empty) != "", "empty expectations are still checked")
    return unittest.end(env)

def _tool_conflict_test_impl(ctx):
    env = unittest.begin(ctx)
    asserts.equals(env, "", tool_conflict_error(_manifest()), "control: one selection")

    def second(target_path):
        def mutate(raw):
            raw["selections"].append(dict(raw["selections"][0], id = "extra", launcher_dir = "x"))
            raw["tools"].append(dict(raw["tools"][0], selection = "extra", target_path = target_path, launcher_path = "x/cmake", record_path = "x/cmake.launch"))

        return tool_conflict_error(_manifest(_mutated(mutate)))

    err = second(_PKG + "/bin/other")
    asserts.true(env, "cmake" in err and "'default'" in err and "'extra'" in err, "names the tool and both selections: " + err)
    asserts.equals(env, "", second(_PKG + "/bin/cmake"), "the same target twice is not a conflict")
    return unittest.end(env)

