_SET = "ocx/tests/testdata/set/"

def _isolated_env_test_impl(ctx):
    env = unittest.begin(ctx)
    read = []
    watched = []

    def getenv(key):
        read.append(key)
        return {
            "OCX_HOME": "/client/home",
            "OCX_OFFLINE": "1",
            "OCX_AUTH_X_TOKEN": "s3cret",
            "HOME": "/home/u",
            "XDG_CONFIG_HOME": "/home/u/.config",
        }.get(key)

    rctx = struct(
        os = struct(name = "Linux"),
        getenv = getenv,
        path = lambda p: "/repo/" + str(p),
        watch = watched.append,
        attr = struct(
            no_config = False,
            config = None,
            patch_snapshot = None,
            sigstore_trusted_root = None,
            allow_unverified = False,
            allow_yanked = False,
        ),
    )
    result = make_isolated_ocx_env(rctx, "/repo/.scratch")
    asserts.equals(env, "/repo/.scratch", result.env["OCX_HOME"], "a fresh home, not the client's")
    asserts.equals(env, "/repo/.scratch", result.home)
    asserts.equals(env, "1", result.env["OCX_OFFLINE"], "site rows are forwarded")
    asserts.false(env, "OCX_AUTH_X_TOKEN" in result.env, "no credential variable")
    asserts.false(env, "OCX_HOME" in read, "the client's OCX_HOME is never read")
    asserts.equals(env, [], [k for k in read if "TOKEN" in k or "KEY" in k or "PASSWORD" in k or "AUTH" in k or "SECRET" in k], "no secret read through getenv")
    asserts.false(env, [w for w in watched if "/client/home" in w], "the client's home is never watched: {}".format(watched))
    asserts.true(env, [w for w in watched if w.startswith("/home/u/")], "the user config tier is watched: {}".format(watched))
    asserts.equals(env, "0", result.env["OCX_NO_VERIFY"])
    return unittest.end(env)

isolated_env_test = unittest.make(_isolated_env_test_impl)

# A rule cannot be created from a macro, so the tool rule is bound to its
# toolchain type here, at load time.
_test_tool = make_ocx_tool_rule(Label("//ocx/tests:set_repo_tests_type"))

def _set_analysis_impl(ctx):
    env = analysistest.begin(ctx)
    target = analysistest.target_under_test(env)
    runfiles = [f.short_path for f in target[DefaultInfo].default_runfiles.files.to_list()]
    for path in ["lib/real.txt", "share", "bin/tool", "bin/tool.direct", "_ocx_reserved/0"]:
        asserts.true(env, _SET + path in runfiles, "runfiles hold " + path)

    # Declared in this package, never through root_symlinks of another repository.
    asserts.true(env, _SET + "lib/alias.txt" in runfiles, "the declared link")
    asserts.true(env, _SET + "lib/BUILD" in runfiles, "the reserved file restored at its original path")
    outputs = {o.short_path: a.mnemonic for a in analysistest.target_actions(env) for o in a.outputs.to_list()}
    asserts.equals(env, "UnresolvedSymlink", outputs.get(_SET + "lib/alias.txt"))
    asserts.equals(env, "Symlink", outputs.get(_SET + "lib/BUILD"))
    info = target[OcxSetInfo]
    asserts.equals(env, ["tool"], info.tools.keys())
    asserts.equals(env, _SET + "bin/tool", info.tools["tool"].launcher.short_path)
    asserts.equals(env, _SET + "bin/tool.direct", info.tools["tool"].sidecar.short_path)
    asserts.true(env, _SET + "lib/alias.txt" in [f.short_path for f in info.files.to_list()])
    return analysistest.end(env)

def _tool_analysis_impl(ctx):
    env = analysistest.begin(ctx)
    target = analysistest.target_under_test(env)
    asserts.equals(env, ["ocx/tests/tool", "ocx/tests/tool.direct"], sorted([f.short_path for f in target[DefaultInfo].files.to_list()]), "both links in the tool's own package")
    asserts.equals(env, "ocx/tests/tool", target[DefaultInfo].files_to_run.executable.short_path)
    runfiles = [f.short_path for f in target[DefaultInfo].default_runfiles.files.to_list()]
    for path in [_SET + "lib/real.txt", _SET + "lib/alias.txt", _SET + "bin/tool.direct", "ocx/tests/tool.direct"]:
        asserts.true(env, path in runfiles, "the tool carries the set's runfiles: " + path)
    return analysistest.end(env)

_set_analysis_test = analysistest.make(_set_analysis_impl)
_tool_analysis_test = analysistest.make(
    _tool_analysis_impl,
    config_settings = {"//command_line_option:extra_toolchains": [str(Label("//ocx/tests:set_repo_tests_tc"))]},
)

def set_repo_test_suite(name):
    """Instantiates the set_repo.bzl test suite.

    Args:
        name: name of the test suite target.
    """
    ocx_set(
        name = name + "_set",
        srcs = [
            ":testdata/set/lib/real.txt",
            ":testdata/set/share",
            ":testdata/set/bin/tool",
            ":testdata/set/bin/tool.direct",
            ":testdata/set/_ocx_reserved/0",
        ],
        links = {"testdata/set/lib/alias.txt": "real.txt"},
        reserved = {"testdata/set/_ocx_reserved/0": "testdata/set/lib/BUILD"},
        tools = {"tool": ["testdata/set/bin/tool", "testdata/set/bin/tool.direct"]},
        tags = ["manual"],
    )
    ocx_set_toolchain(name = name + "_impl", set = ":" + name + "_set", tags = ["manual"])
    native.toolchain_type(name = name + "_type")
    native.toolchain(name = name + "_tc", toolchain_type = ":" + name + "_type", toolchain = ":" + name + "_impl")
    _test_tool(name = name + "_tool", tool = "tool", tags = ["manual"])
    _set_analysis_test(name = name + "_set_analysis_test", target_under_test = ":" + name + "_set")
    _tool_analysis_test(name = name + "_tool_analysis_test", target_under_test = ":" + name + "_tool")
    unittest.suite(
        name + "_unit",
        reserved_moves_test,
        build_file_test,
        build_file_golden_test,
        build_file_reserved_test,
        build_file_quoting_test,
        cross_check_test,
        tool_conflict_test,
        pinned_test,
        failure_test,
        windows_link_test,
        vendor_args_test,
        isolated_env_test,
    )
    native.test_suite(
        name = name,
        tests = [":" + name + "_unit", ":" + name + "_set_analysis_test", ":" + name + "_tool_analysis_test"],
    )
