_SET = "ocx/tests/testdata/set/"

def _isolated_env_test_impl(ctx):
    env = unittest.begin(ctx)
    read = []
    watched = []

    def getenv(key):
        read.append(key)
        return {
            "OCX_HOME": "/client/home",
            "OCX_OFFLINE": "1",
            "OCX_AUTH_X_TOKEN": "s3cret",
            "HOME": "/home/u",
            "XDG_CONFIG_HOME": "/home/u/.config",
        }.get(key)

    rctx = struct(
        os = struct(name = "Linux"),
        getenv = getenv,
        path = lambda p: "/repo/" + str(p),
        watch = watched.append,
        attr = struct(
            no_config = False,
            config = None,
            sigstore_trusted_root = None,
            allow_unverified = False,
            allow_yanked = False,
        ),
    )
    result = make_isolated_ocx_env(rctx, "/repo/.scratch")
    asserts.equals(env, "/repo/.scratch", result.env["OCX_HOME"], "a fresh home, not the client's")
    asserts.equals(env, "/repo/.scratch", result.home)
    asserts.equals(env, "1", result.env["OCX_OFFLINE"], "site rows are forwarded")
    asserts.false(env, "OCX_AUTH_X_TOKEN" in result.env, "no credential variable")
    asserts.false(env, "OCX_HOME" in read, "the client's OCX_HOME is never read")
    asserts.equals(env, [], [k for k in read if "TOKEN" in k or "KEY" in k or "PASSWORD" in k or "AUTH" in k or "SECRET" in k], "no secret read through getenv")
    asserts.false(env, [w for w in watched if "/client/home" in w], "the client's home is never watched: {}".format(watched))
    asserts.true(env, [w for w in watched if w.startswith("/home/u/")], "the user config tier is watched: {}".format(watched))
    asserts.equals(env, "0", result.env["OCX_NO_VERIFY"])
    return unittest.end(env)

isolated_env_test = unittest.make(_isolated_env_test_impl)

