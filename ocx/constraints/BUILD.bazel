package(default_visibility = ["//visibility:public"])

# No default value: a platform that does not name a libc matches neither.
constraint_setting(name = "libc")

constraint_value(
    name = "glibc",
    constraint_setting = ":libc",
)

constraint_value(
    name = "musl",
    constraint_setting = ":libc",
)
