"""Repository rule that vendors one platform's tool set with `ocx vendor`."""

load(":manifest.bzl", "is_sha256")
load(":repo_utils.bzl", "CONFIG_ATTRS", "POLICY_ATTRS", "SYSEXIT_HINTS", "execute_ocx", "make_isolated_ocx_env", "ocx_bin")
load(":vendor_manifest.bzl", "RESERVED_NAMES", "read_manifest")

visibility(["//ocx", "//ocx/tests"])

# The public re-export: a generated BUILD file of another repository cannot load
# a private `.bzl`.
_DEFS = str(Label("//ocx:defs.bzl"))

_STASH = "_ocx_reserved"

# The three top-level entries of an `ocx vendor` output directory.
_TOP_LEVEL = ["manifest.json", "packages", "selections"]

def _is_reserved(path):
    return path.split("/")[-1].lower() in RESERVED_NAMES

def _sidecar(launcher):
    """The `.direct` sidecar beside a launcher; `<self>.exe` pairs with `<self>.direct`."""
    stem = launcher[:-len(".exe")] if launcher.endswith(".exe") else launcher
    return stem + ".direct"

def _label(path):
    # `:` first, so a path starting with `@` or `//` stays a name in this package.
    return repr(":" + path)

def _quoted_list(items, indent):
    if not items:
        return "[]"
    pad = " " * indent
    return "[\n" + "".join([pad + "    " + item + ",\n" for item in items]) + pad + "]"

def _quoted_dict(rows, indent):
    if not rows:
        return "{}"
    pad = " " * indent
    return "{\n" + "".join([pad + "    " + key + ": " + value + ",\n" for key, value in rows]) + pad + "}"

def _all_paths(manifest):
    """Every manifest path that ends up in the generated BUILD file."""
    paths = []
    for package in manifest.packages:
        paths += [package.package_dir, package.content_dir]
        paths += [e.launcher_path for e in package.entrypoints]
        if package.tree:
            paths += [f.path for f in package.tree.files]
            paths += [link.path for link in package.tree.links]
            paths += package.tree.link_free_dirs
    paths += [s.launcher_dir for s in manifest.selections]
    for tool in manifest.tools:
        paths.append(tool.target_path)
        if tool.launcher_path:
            paths.append(tool.launcher_path)
    return paths

def build_file_content(manifest, moves):
    """The generated BUILD.bazel text of a set repository.

    One directory label per link-free directory that holds no moved file, a
    file label for every other regular file, the declared links, the moved
    reserved files, and every launcher and sidecar. The targets are `:set` (an
    `ocx_set`) and `:toolchain_impl` (its `ocx_set_toolchain`); the hub
    declares the `toolchain()`.

    Args:
        manifest: the parse_manifest() manifest.
        moves: the `moves` list of reserved_moves().

    Returns:
        BUILD.bazel text.
    """
    moved = {m.src: m.dst for m in moves}
    srcs = {}
    links = []
    for package in manifest.packages:
        tree = package.tree
        if not tree:
            continue
        dirs = [
            d
            for d in tree.link_free_dirs
            if not [m for m in moved if m.startswith(d + "/")]
        ]
        for directory in dirs:
            srcs[directory] = True
        for file in tree.files:
            if file.path in moved:
                continue
            if [d for d in dirs if file.path.startswith(d + "/")]:
                continue
            srcs[file.path] = True
        links += [(repr(link.path), repr(link.target)) for link in tree.links]
        for entry in package.entrypoints:
            srcs[entry.launcher_path] = True
            srcs[_sidecar(entry.launcher_path)] = True
    tools = {}
    for tool in manifest.tools:
        if not tool.launcher_path or tool.name in tools:
            continue
        sidecar = _sidecar(tool.launcher_path)
        srcs[tool.launcher_path] = True
        srcs[sidecar] = True
        tools[tool.name] = [repr(tool.launcher_path), repr(sidecar)]
    for move in moves:
        srcs[move.dst] = True
    return "\n".join([
        "# Generated by rules_ocx from manifest.json. Do not edit.",
        "load({}, \"ocx_set\", \"ocx_set_toolchain\")".format(repr(_DEFS)),
        "",
        "package(default_visibility = [\"//visibility:public\"])",
        "",
        "ocx_set(",
        "    name = \"set\",",
        "    srcs = {},".format(_quoted_list([_label(p) for p in srcs], 4)),
        "    links = {},".format(_quoted_dict(links, 4)),
        "    reserved = {},".format(_quoted_dict([(repr(m.dst), repr(m.src)) for m in moves], 4)),
        "    tools = {},".format(_quoted_dict([(repr(n), _quoted_list(v, 8)) for n, v in tools.items()], 4)),
        ")",
        "",
        "ocx_set_toolchain(",
        "    name = \"toolchain_impl\",",
        "    set = \":set\",",
        ")",
        "",
    ])

def reserved_moves(manifest):
    """The files the vendored tree holds that Bazel reserves (pure).

    Args:
        manifest: the parse_manifest() manifest.

    Returns:
        struct(moves, error). `moves` is [struct(src, dst)] with
        `dst = "_ocx_reserved/<n>"`, n from 0 in manifest order. `error` is
        non-empty when the vendored top level already holds `_ocx_reserved`.
    """
    for path in _all_paths(manifest):
        if path.split("/")[0] == _STASH:
            return struct(moves = [], error = "the vendored tree already holds a top-level '{}' ('{}'); rules_ocx keeps Bazel-reserved files there".format(_STASH, path))
    moves = []
    for package in manifest.packages:
        if not package.tree:
            continue
        for file in package.tree.files:
            if _is_reserved(file.path):
                moves.append(struct(src = file.path, dst = "{}/{}".format(_STASH, len(moves))))
    return struct(moves = moves, error = "")

def cross_check(manifest, expected):
    """Compares the manifest with the fact recorded at module resolution.

    Args:
        manifest: the parse_manifest() manifest.
        expected: struct(platform, tools = [[name, kind], ...], available_platforms = [...])
            for this set's platform, taken from the fact; `platform` is the
            one the repository was asked to vendor.

    Returns:
        error string, "" when they agree. The text names
        `bazel mod deps --lockfile_mode=update`.
    """
    actual_tools = sorted(["{}:{}".format(t.name, t.kind) for t in manifest.tools])
    wanted_tools = sorted(["{}:{}".format(t[0], t[1]) for t in expected.tools])
    actual_platforms = sorted(manifest.available_platforms)
    wanted_platforms = sorted(expected.available_platforms)
    problems = []
    if manifest.platform != expected.platform:
        problems.append("the manifest is for platform {} where {} was requested".format(manifest.platform, expected.platform))
    if actual_tools != wanted_tools:
        problems.append("tools are {} where the fact recorded {}".format(actual_tools, wanted_tools))
    if actual_platforms != wanted_platforms:
        problems.append("available platforms are {} where the fact recorded {}".format(actual_platforms, wanted_platforms))
    if not problems:
        return ""
    return ("the vendored set for {} disagrees with the fact in MODULE.bazel.lock: {}; " +
            "the lock entry is stale for this ocx — run `bazel mod deps --lockfile_mode=update`").format(
        manifest.platform,
        "; ".join(problems),
    )

def tool_conflict_error(manifest):
    """Refuses two selections that declare one tool name for different targets (pure).

    The hub names a tool once, so the second launcher would be unreachable.

    Args:
        manifest: the parse_manifest() manifest.

    Returns:
        error string naming the tool and both selections, "" when fine.
    """
    first = {}
    for tool in manifest.tools:
        seen = first.get(tool.name)
        if seen == None:
            first[tool.name] = tool
        elif seen.target_path != tool.target_path:
            return "tool '{}' is declared by selection '{}' and by selection '{}' with different targets ('{}' and '{}'); bind it from one selection only".format(
                tool.name,
                seen.selection,
                tool.selection,
                seen.target_path,
                tool.target_path,
            )
    return ""

def windows_link_error(manifest):
    """Refuses a windows platform whose manifest lists links.

    Args:
        manifest: the parse_manifest() manifest.

    Returns:
        error string naming the package identifier, "" when fine.
    """
    if not manifest.platform.startswith("windows/"):
        return ""
    for package in manifest.packages:
        if package.tree and package.tree.links:
            return ("platform {} cannot carry the link '{}' of package {} — Bazel declares " +
                    "no symlinks on Windows; drop the platform or the package").format(
                manifest.platform,
                package.tree.links[0].path,
                package.identifier,
            )
    return ""

def vendor_args(attr_values):
    """The ocx argv after the binary for one vendor call.

    Project tier: `["--format", "json", "vendor", "-o", out, "-p", platform,
    "--omit-links", "-g", g ..., name ...]`. Package tier: `["--format",
    "json", "package", "vendor", "-o", out, "-p", platform, "--omit-links",
    identifier]`. Root flags (`--project <toml>`, `--index`, one `--blob-dir`
    per blob dir) come before `vendor`; they are read from the optional
    fields `project`, `index` and `blob_dirs` of `attr_values`.

    Args:
        attr_values: struct(tier, out, platform, groups, bindings, package),
            plus optionally project, index and blob_dirs.

    Returns:
        struct(args, error).
    """
    root = ["--format", "json"]
    project = getattr(attr_values, "project", "")
    if project:
        root += ["--project", project]
    index = getattr(attr_values, "index", "")
    if index:
        root += ["--index", index]
    for blob_dir in getattr(attr_values, "blob_dirs", []):
        root += ["--blob-dir", blob_dir]
    common = ["-o", attr_values.out, "-p", attr_values.platform, "--omit-links"]
    if attr_values.tier == "project":
        args = root + ["vendor"] + common
        for group in attr_values.groups:
            args += ["-g", group]
        return struct(args = args + list(attr_values.bindings), error = "")
    if attr_values.tier == "package":
        if not attr_values.package:
            return struct(args = [], error = "the package tier needs a package identifier")
        return struct(args = root + ["package", "vendor"] + common + [attr_values.package], error = "")
    return struct(args = [], error = "unknown tier '{}'".format(attr_values.tier))

def package_pinned(package):
    """Whether a package identifier ends in `@sha256:` plus a full digest.

    Args:
        package: the identifier.

    Returns:
        True when the digest is 64 lowercase hex characters.
    """
    return "@sha256:" in package and is_sha256(package.split("@sha256:")[-1])

def vendor_failure(args, code, stderr):
    """The failure text of one ocx run, "" on exit 0 (pure).

    Args:
        args: the argv after the binary.
        code: exit code.
        stderr: captured stderr.

    Returns:
        message with the sysexits hint, or "".
    """
    if code == 0:
        return ""
    hint = SYSEXIT_HINTS.get(code)
    return "ocx {} failed (exit {}): {}{}".format(" ".join(args), code, stderr.strip(), "\nhint: " + hint if hint else "")

def _path_flag(rctx, label):
    """Absolute path of a label attr, watched so an edit refetches."""
    path = rctx.path(label)
    if path.is_dir:
        rctx.watch_tree(path)
    else:
        rctx.watch(path)
    return str(path)

def _ocx_set_repo_impl(rctx):
    is_windows = rctx.os.name.lower().startswith("windows")
    binary = ocx_bin(rctx)
    attrs = rctx.attr
    project = ""
    if attrs.tier == "project":
        if not attrs.ocx_toml or not attrs.ocx_lock:
            fail("rules_ocx: the project tier needs ocx_toml and ocx_lock")
        rctx.watch(attrs.ocx_toml)
        rctx.watch(attrs.ocx_lock)
        toml = rctx.path(attrs.ocx_toml)

        # ocx reads the lock beside the toml; any other label would be checked never.
        if rctx.path(attrs.ocx_lock) != toml.dirname.get_child("ocx.lock"):
            fail("rules_ocx: ocx_lock {} must be the ocx.lock next to ocx_toml {}".format(attrs.ocx_lock, attrs.ocx_toml))
        project = str(toml)

    out = rctx.path(".vendor_out")
    scratch_home = rctx.path(".ocx_scratch_home")
    planned = vendor_args(struct(
        tier = attrs.tier,
        out = str(out),
        platform = attrs.platform,
        groups = attrs.groups,
        bindings = attrs.bindings,
        package = attrs.package,
        project = project,
        index = _path_flag(rctx, attrs.index) if attrs.index else "",
        blob_dirs = [_path_flag(rctx, d) for d in attrs.blob_dirs],
    ))
    if planned.error:
        fail("rules_ocx: " + planned.error)

    ocx_env = make_isolated_ocx_env(rctx, str(scratch_home))
    result = execute_ocx(rctx, binary, planned.args, ocx_env.env, is_windows)

    # Before any fail(): the scratch home and the output directory never outlive the call.
    rctx.delete(scratch_home)
    problem = vendor_failure(planned.args, result.return_code, result.stderr)
    if not problem and not out.get_child("manifest.json").exists:
        problem = "`ocx vendor` exited 0 but wrote no manifest.json into its output directory"
    if not problem and out.get_child(_STASH).exists:
        problem = "the vendored tree already holds a top-level '{}'".format(_STASH)
    if problem:
        rctx.delete(out)
        fail("rules_ocx: vendoring {} for {}: {}".format(attrs.package or attrs.ocx_toml, attrs.platform, problem))
    for name in _TOP_LEVEL:
        if out.get_child(name).exists:
            rctx.rename(out.get_child(name), rctx.path(name))
    rctx.delete(out)

    manifest = read_manifest(rctx, rctx.path("manifest.json"))
    if manifest.content != "present":
        fail("rules_ocx: `ocx vendor` wrote a manifest with content '{}'; a set needs its files".format(manifest.content))
    err = windows_link_error(manifest)
    if err:
        fail("rules_ocx: " + err)
    err = cross_check(manifest, struct(
        platform = attrs.platform,
        tools = [row.split(":", 1) for row in attrs.expected_tools],
        available_platforms = attrs.expected_available_platforms,
    ))
    if err:
        fail("rules_ocx: " + err)
    err = tool_conflict_error(manifest)
    if err:
        fail("rules_ocx: " + err)

    stashed = reserved_moves(manifest)
    if stashed.error:
        fail("rules_ocx: " + stashed.error)
    for move in stashed.moves:
        rctx.rename(rctx.path(move.src), rctx.path(move.dst))
    rctx.file("BUILD.bazel", build_file_content(manifest, stashed.moves))

    # Only a digest-pinned root is a function of the lockfile.
    pinned = attrs.tier == "project" or package_pinned(attrs.package)
    if pinned:
        return rctx.repo_metadata(reproducible = True)
    return None

ocx_set_repo = repository_rule(
    implementation = _ocx_set_repo_impl,
    doc = """One platform's vendored tool set, produced by `ocx vendor`.

The repository holds the vendored tree, the generated `BUILD.bazel` and the
`ocx_set` / `ocx_set_toolchain` targets over it.""",
    attrs = CONFIG_ATTRS | POLICY_ATTRS | {
        "bindings": attr.string_list(doc = "Tool names to bind (project tier)."),
        "blob_dirs": attr.label_list(doc = "Directories passed as `--blob-dir`."),
        "expected_available_platforms": attr.string_list(
            doc = "available_platforms recorded in the fact; cross-checked against the manifest.",
        ),
        "expected_digest": attr.string(
            doc = "Root platform manifest digest recorded in the fact; empty skips the check.",
        ),
        "expected_tools": attr.string_list(
            doc = "`name:kind` rows recorded in the fact for this platform; cross-checked against the manifest.",
        ),
        "groups": attr.string_list(doc = "ocx.toml groups to vendor (project tier)."),
        "hub": attr.string(doc = "Name of the hub this set belongs to, for the update hint."),
        "index": attr.label(doc = "Optional index passed as `--index`."),
        "kind": attr.string(
            values = ["", "tag", "pinned", "index", "project"],
            doc = "The declaration kind, which decides the check tail and the vendor flags.",
        ),
        "ocx": attr.label(
            default = "@ocx_tool//:ocx",
            allow_single_file = True,
            doc = "The pinned ocx CLI binary.",
        ),
        "ocx_lock": attr.label(allow_single_file = True, doc = "The ocx.lock next to ocx_toml (project tier)."),
        "ocx_toml": attr.label(allow_single_file = True, doc = "The project ocx.toml (project tier)."),
        "package": attr.string(doc = "Package identifier (package tier)."),
        "platform": attr.string(mandatory = True, doc = "ocx platform key to vendor for."),
        "tier": attr.string(
            mandatory = True,
            values = ["project", "package"],
            doc = "Which `ocx vendor` form to call.",
        ),
    },
)
