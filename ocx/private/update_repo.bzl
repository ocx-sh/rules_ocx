"""The `ocx_update` repository: one pre-configured `ocx` run target per updatable declaration.

A target is the fetched `ocx` binary itself, with the arguments and the
environment of its declaration baked in, so `bazel run @<hub>//:update` is one
`ocx` invocation and nothing else. Only a `project` declaration whose
`ocx.toml` and `ocx.lock` sit in the main repository, and an `index`
declaration whose snapshot does, get one: those are the files `ocx` may write.
Not reproducible: the arguments hold absolute paths of this machine.
"""

load(":repo_utils.bzl", "OCX_ENV_CLASSES")

visibility(["//ocx", "//ocx/tests"])

# An executable rule that is the `ocx` binary: `args` is Bazel's own attribute
# of every executable rule, `bazel run` appends what follows `--` after it.
_RULE_BZL = """# Generated by ocx_update_repo.
def _impl(ctx):
    out = ctx.actions.declare_file("{}_ocx.{}".format(ctx.label.name, ctx.file.src.extension) if ctx.file.src.extension else ctx.label.name + "_ocx")
    ctx.actions.symlink(output = out, target_file = ctx.file.src, is_executable = True)
    return [DefaultInfo(executable = out, files = depset([out])), RunEnvironmentInfo(environment = ctx.attr.env)]

ocx_update = rule(
    implementation = _impl,
    attrs = {
        "env": attr.string_dict(),
        "src": attr.label(allow_single_file = True, mandatory = True),
    },
    executable = True,
)
"""

def quote_arg(value):
    """One argument as Bazel reads it from a target's `args` (pure).

    Bazel expands Make variables in `args`, then splits the result like a
    Bourne shell. Single quotes keep spaces, `=`, `,` and backslashes intact,
    and a doubled `$` is Bazel's spelling of a literal one.

    Args:
        value: the argument.

    Returns:
        the argument as one single-quoted token.
    """
    return "'" + value.replace("$", "$$").replace("'", "'\\''") + "'"

def update_env(no_config, config, trusted_root, allow_unverified, allow_yanked):
    """The environment of one update run, in the order the old program exported it (pure).

    The pinned rows of OCX_ENV_CLASSES, then (`no_config`) the hermetic rows
    blanked and `OCX_NO_CONFIG=1`, then the declared `OCX_CONFIG` and
    `OCX_SIGSTORE_TRUSTED_ROOT`, then the policy pair, always written.

    Args:
        no_config: the declaration's `no_config`.
        config: absolute path of the declared config file, or "".
        trusted_root: absolute path of the declared trusted root, or "".
        allow_unverified: the policy's `allow_unverified`.
        allow_yanked: the policy's `allow_yanked`.

    Returns:
        dict env name -> value.
    """
    env = {}
    for key, row in OCX_ENV_CLASSES.items():
        if row.cls == "pinned":
            env[key] = row.value
    if no_config:
        for key, row in OCX_ENV_CLASSES.items():
            if row.hermetic:
                env[key] = ""
        env["OCX_NO_CONFIG"] = "1"
    if config:
        env["OCX_CONFIG"] = config
    if trusted_root:
        env["OCX_SIGSTORE_TRUSTED_ROOT"] = trusted_root
    env["OCX_NO_VERIFY"] = "1" if allow_unverified else "0"
    env["OCX_ALLOW_YANKED"] = "1" if allow_yanked else "0"
    return env

def update_args(kind, path, identifier, groups, bindings):
    """The baked arguments of one update target (pure; unquoted).

    Args:
        kind: "project" or "index".
        path: absolute path of the `ocx.toml` (project) or the snapshot directory (index).
        identifier: the package identifier, for an index.
        groups: the project's groups.
        bindings: the project's bindings.

    Returns:
        list of arguments.
    """
    if kind == "index":
        return ["--index", path, "index", "update", identifier]
    args = ["--project", path, "update", "--no-pull"]
    for group in groups:
        args += ["-g", group]
    return args + list(bindings)

def update_build_content(ocx, targets):
    """The update repository's BUILD.bazel text (pure).

    Args:
        ocx: label string of the ocx binary.
        targets: list of struct(name, args, env); `args` unquoted.

    Returns:
        BUILD.bazel text.
    """
    out = ['load(":rule.bzl", "ocx_update")', ""]
    for t in targets:
        out += [
            "ocx_update(",
            "    name = {},".format(repr("hub_" + t.name)),
            "    src = {},".format(repr(ocx)),
            "    args = {},".format(repr([quote_arg(a) for a in t.args])),
            "    env = {},".format(repr(t.env)),
            '    visibility = ["//visibility:public"],',
            ")",
            "",
        ]
    return "\n".join(out)

def in_main_repo(label):
    """Whether a declared lock or index file belongs to the main repository (pure).

    Only such a file may be written by `ocx`. The label's repository decides,
    not the module that declared it: a root module can name a file of a
    dependency, and `@@//:file` from any module names the main repository.

    Args:
        label: the `ocx_lock` or `index` label, or None for a kind without a file.

    Returns:
        True when `label` is None or its canonical repository name is empty.
    """
    return label == None or label.repo_name == ""

def has_update_target(kind, lock, toml, index):
    """Whether a declaration gets an update target (pure).

    `ocx --project <toml>` reads and writes the `ocx.lock` beside the
    `ocx.toml`, so a project declaration qualifies only when both labels are
    main-repository files named so, in one package. An index qualifies when its
    snapshot is a main-repository file. `tag` and `pinned` never do.

    Args:
        kind: the declaration kind.
        lock: the `ocx_lock` label, or None.
        toml: the `ocx_toml` label, or None.
        index: the `index` label, or None.

    Returns:
        bool.
    """
    if kind == "project":
        return (in_main_repo(lock) and in_main_repo(toml) and lock.name == "ocx.lock" and
                toml.name == "ocx.toml" and lock.package == toml.package)
    if kind == "index":
        return in_main_repo(index)
    return False

def _ocx_update_repo_impl(rctx):
    targets = []
    for text in sorted(rctx.attr.declarations):
        d = json.decode(text)
        name = d["name"]
        files = rctx.attr.files
        if d["kind"] == "project":
            path = str(rctx.path(files[name + ":toml"]))
        else:
            path = str(rctx.path(files[name + ":index"]))
        config = files.get(name + ":config")
        trusted_root = files.get(name + ":trusted_root")
        targets.append(struct(
            name = name,
            args = update_args(d["kind"], path, d["identifier"], d["groups"], d["bindings"]),
            env = update_env(
                d["no_config"],
                str(rctx.path(config)) if config != None else "",
                str(rctx.path(trusted_root)) if trusted_root != None else "",
                d["allow_unverified"],
                d["allow_yanked"],
            ),
        ))
    rctx.file("rule.bzl", _RULE_BZL)

    # Windows starts only a file named `.exe`; `@ocx_tool` holds `ocx.exe` beside `ocx` there.
    ocx = str(rctx.attr.ocx) + (".exe" if "windows" in rctx.os.name.lower() else "")
    rctx.file("BUILD.bazel", update_build_content(ocx, sorted(targets, key = lambda t: t.name)))

ocx_update_repo = repository_rule(
    implementation = _ocx_update_repo_impl,
    doc = """The update targets of the declarations that have one.

Declares `hub_<name>` per entry of `declarations`: the `ocx` binary with the
arguments and environment of that declaration baked in. The extension lists
only declarations `has_update_target` accepts.""",
    attrs = {
        "declarations": attr.string_list(
            doc = "One `json.encode`d object per updatable declaration, with keys name, kind (`project` or `index`), identifier, no_config, allow_unverified, allow_yanked, groups, bindings.",
        ),
        "files": attr.string_keyed_label_dict(
            doc = "Keys `<name>:toml` (project), `<name>:index`, `<name>:config`, `<name>:trusted_root`.",
        ),
        "ocx": attr.label(
            mandatory = True,
            doc = "The ocx binary, `@ocx_tool//:ocx`; referenced by label only; nothing fetches it here.",
        ),
    },
)
