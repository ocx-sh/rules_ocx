@echo off
rem SPDX-License-Identifier: Apache-2.0
rem Copyright 2026 The OCX Authors
rem
rem Generated by ocx_update_repo. It reads every declaration value from plan.txt at run time, so no value from
rem MODULE.bazel is program text; the only values filled in below are two absolute paths, a target index and the
rem pinned env rows. Run it with `bazel run`, never by hand: BUILD_WORKSPACE_DIRECTORY must name the workspace.
rem
rem Exit: 0 done or nothing to move; 64 usage (E1 E2 E3 E9 E13); 70 plan unreadable; 74 an io failure; 75 Bazel
rem output base locked (E11); 78 no bazel (E8) or a refused write target (E12 E14); else the exit code of the first
rem failing ocx run, else of the nested bazel call.
rem
rem Delayed expansion is never enabled: a path or a value may hold "!". A plan value is used inside quotes, except in
rem a few `if defined` lookups of declaration names, whose safe set holds no character cmd acts on. An argument is
rem read only after E13 has accepted the whole line: for @rules_ocx//:update every character is in the declaration-name
rem set and the name lookup compares through findstr; for a hub target the arguments are not looked at again and
rem reach the command line of ocx unquoted, where E13 has refused every character cmd would act on.
setlocal DisableDelayedExpansion

set "PLAN=@PLAN@"
set "OCX=@OCX@"
set "TARGET=@TARGET@"

if not defined BUILD_WORKSPACE_DIRECTORY goto :e9

rem E13 comes before any other look at the arguments: only an argument line free of the characters the message
rem names is safe to parse. The REM technique (jeb, https://stackoverflow.com/a/4095133) copies the argument line as
rem text into a file without executing it; findstr then looks for those characters after the first hash sign. A capture
rem that holds no pair of hash signs is an internal error, so a capture that did not work never reads as a clean line.
set "ARGF=rules_ocx_args_%RANDOM%%RANDOM%.txt"
set "PATF=rules_ocx_pat_%RANDOM%%RANDOM%.txt"
pushd "%TEMP%" || goto :e74
set "prompt=@"
(
  @echo on
  @for %%a in (1) do rem #%*#
  @echo off
) >"%ARGF%"
if "%TARGET%"=="0" goto :pat_names
>"%PATF%" echo #.*[^&^|^<^>^^%%"]
goto :pat_done
:pat_names
rem Declaration names only: the line may hold nothing but the name set and the spaces between names. A tab, a comma, a
rem semicolon, an equals sign and every cmd metacharacter fall outside it, and the hash signs of the capture bound the line.
>"%PATF%" echo #.*[^^A-Za-z0-9._:/@+ #-].*#
:pat_done
findstr /r /g:"%PATF%" "%ARGF%" >nul
set "UNSAFE=%ERRORLEVEL%"
findstr /r "#.*#" "%ARGF%" >nul
set "CAPTURED=%ERRORLEVEL%"
del /q "%ARGF%" "%PATF%" >nul 2>&1
popd
if not "%CAPTURED%"=="0" goto :e70args
if "%UNSAFE%"=="0" goto :e13
if not "%UNSAFE%"=="1" goto :e70args

rem The line passed E13, so a shift loop over the arguments and the whole line are safe to read.
set "NARGS=0"
set "UARGS=%*"
set "COUNT=0"
set "POS=0"
set "ST=1"
set "PASS=1"
set "KNOWN="
set "T_KIND="
set "T_NAME="

rem Pass 1: the known names and the target's kind. findstr /n keeps empty lines; the number prefix is cut off again.
call :read_plan
if not "%ST%"=="1" goto :e70plan

set "HAS_DASH="
set "BAD_ARG="
:args_loop
if "%~1"=="" goto :args_done
set /a NARGS+=1
set "ARG=%~1"
if "%ARG:~0,1%"=="-" set "HAS_DASH=1"
if not "%TARGET%"=="0" goto :arg_next
rem A known name is one whole line of the variable listing, KN_ then the name then =1; findstr reads ARG as a literal, never as program text.
set "ARG_HIT="
set KN_ 2>nul | findstr /x /c:"KN_%ARG%=1" >nul && set "ARG_HIT=1"
if not defined ARG_HIT if not defined BAD_ARG set "BAD_ARG=%ARG%"
set "ARGSET_%ARG%=1"
:arg_next
shift
goto :args_loop
:args_done

if not "%TARGET%"=="0" goto :check_hub
if defined HAS_DASH goto :e3
if defined BAD_ARG goto :e1
goto :checked
:check_hub
if "%T_KIND%"=="project" goto :checked
if not "%NARGS%"=="0" goto :e2
:checked
if "%COUNT%"=="0" (
  >&2 echo rules_ocx: no ocx declarations
  exit /b 0
)

rem Pass 2: what runs. E4 and E5 are notices, not failures.
set "PASS=2"
set "POS=0"
set "ANYSEL="
call :read_plan
if not defined ANYSEL exit /b 0

rem Step 1: a bazel that cannot start must stop the run before anything is written.
if not defined RULES_OCX_BAZEL set "RULES_OCX_BAZEL=bazel"
where /q "%RULES_OCX_BAZEL%" >nul 2>&1 && goto :bazel_ok
if exist "%RULES_OCX_BAZEL%" goto :bazel_ok
>&2 echo rules_ocx: no bazel found; put bazel on PATH or set RULES_OCX_BAZEL
exit /b 78
:bazel_ok
pushd "%BUILD_WORKSPACE_DIRECTORY%" || goto :e74
call "%RULES_OCX_BAZEL%" --noblock_for_lock info output_base >nul <nul
set "PRE_RC=%ERRORLEVEL%"
popd
if "%PRE_RC%"=="0" goto :preflight_ok
if "%PRE_RC%"=="9" goto :e11
>&2 echo rules_ocx: bazel info output_base failed (exit %PRE_RC%)
exit /b %PRE_RC%
:preflight_ok

:scratch_try
set "SCRATCH=%TEMP%\rules_ocx_update_%RANDOM%%RANDOM%"
if exist "%SCRATCH%" goto :scratch_try
mkdir "%SCRATCH%" || goto :e74

rem Step 2: each selected declaration, in name order.
set "PASS=3"
set "POS=0"
set "RUNN=0"
set "NAMES="
set "FIRST_OCX="
set "FIRST_REF="
set "HUBARGS="
if not "%TARGET%"=="0" if not "%NARGS%"=="0" set "HUBARGS=1"
call :read_plan

rem Step 3: one nested bazel call moves the facts of everything that was selected.
set "FINAL=0"
if not defined NAMES goto :step4
pushd "%BUILD_WORKSPACE_DIRECTORY%" || goto :e74
call "%RULES_OCX_BAZEL%" --noblock_for_lock mod deps --lockfile_mode=update "--repo_env=RULES_OCX_UPDATE=%NAMES%" <nul
set "NESTED_RC=%ERRORLEVEL%"
popd
if "%NESTED_RC%"=="0" goto :step4
if "%NESTED_RC%"=="9" goto :nested_locked
>&2 echo rules_ocx: bazel mod deps --lockfile_mode=update failed (exit %NESTED_RC%); no fact moved; the ocx.lock and snapshot files written above stay; once the cause is fixed, run bazel mod deps --lockfile_mode=update
set "FINAL=%NESTED_RC%"
goto :step4
:nested_locked
>&2 echo rules_ocx: the Bazel output base is locked ^(another command, or bazel --batch run^); run the update again without --batch
set "FINAL=75"

rem Step 4: the first failing ocx run, else the first refusal, else the nested call.
:step4
if defined FIRST_REF set "FINAL=%FIRST_REF%"
if defined FIRST_OCX set "FINAL=%FIRST_OCX%"
rd /s /q "%SCRATCH%" >nul 2>&1
exit /b %FINAL%

:e1
for /f "delims=" %%P in ("%BAD_ARG%") do >&2 echo(rules_ocx: no ocx declaration is named '%%P'; known: %KNOWN%
exit /b 64
:e2
>&2 echo rules_ocx: '%T_NAME%' is an ocx.package declaration; its update takes no arguments
exit /b 64
:e3
>&2 echo rules_ocx: @rules_ocx//:update takes declaration names only; pass ocx update arguments to @^<name^>//:update
exit /b 64
:e9
>&2 echo rules_ocx: run this target with bazel run
exit /b 64
:e11
>&2 echo rules_ocx: the Bazel output base is locked ^(another command, or bazel --batch run^); run the update again without --batch
exit /b 75
:e13
>&2 echo rules_ocx: an update argument holds one of ^& ^| ^< ^> ^^ %% "; for @rules_ocx//:update any character outside A-Z a-z 0-9 . _ : / @ + - counts too; rename the group or binding, or run the update on a POSIX host
exit /b 64
:e70args
>&2 echo rules_ocx: internal error: the argument line could not be read
exit /b 70
:e70plan
>&2 echo rules_ocx: internal error: plan.txt ends inside a declaration
exit /b 70
:e74
>&2 echo rules_ocx: cannot create a scratch file under the temporary directory
exit /b 74

rem ---------------------------------------------------------------------------------------------------------------
rem plan.txt, one line per call of :field, a state machine over the fixed field order.
:read_plan
set "ST=1"
for /f "usebackq delims=" %%a in (`findstr /n "^" "%PLAN%"`) do (set "L=%%a" & call :field)
exit /b 0

:field
set "L=%L:*:=%"
goto :f_%ST%

:f_1
set "D_NAME=%L%"
set "ST=2"
exit /b 0
:f_2
set "D_KIND=%L%"
set "ST=3"
exit /b 0
:f_3
set "D_MAIN=%L%"
set "ST=4"
exit /b 0
:f_4
set "D_WRITE=%L%"
set "ST=5"
exit /b 0
:f_5
set "D_ID=%L%"
set "ST=6"
exit /b 0
:f_6
set "D_CONFIG=%L%"
set "ST=7"
exit /b 0
:f_7
set "D_NOCFG=%L%"
set "ST=8"
exit /b 0
:f_8
set "D_UNVER=%L%"
set "ST=9"
exit /b 0
:f_9
set "D_YANKED=%L%"
set "ST=10"
exit /b 0
:f_10
set "D_ROOT=%L%"
set "ST=11"
exit /b 0
:f_11
set "NG=%L%"
set "D_GARGS="
set "ST=12"
if "%NG%"=="0" set "ST=13"
exit /b 0
:f_12
rem Group values use the plan's safe set (A-Za-z0-9 . _ : / @ + = , -): none is special to cmd, so they need no quotes.
set "D_GARGS=%D_GARGS% -g %L%"
set /a NG-=1
if "%NG%"=="0" set "ST=13"
exit /b 0
:f_13
set "NB=%L%"
set "D_BARGS="
set "ST=14"
if "%NB%"=="0" goto :decl
exit /b 0
:f_14
set "D_BARGS=%D_BARGS% %L%"
set /a NB-=1
if "%NB%"=="0" goto :decl
exit /b 0

:decl
set "ST=1"
goto :decl_%PASS%

:decl_1
set /a COUNT+=1
set "KN_%D_NAME%=1"
if "%COUNT%"=="%TARGET%" set "T_KIND=%D_KIND%" & set "T_NAME=%D_NAME%"
if defined KNOWN goto :known_more
set "KNOWN=%D_NAME%"
exit /b 0
:known_more
set "KNOWN=%KNOWN%, %D_NAME%"
exit /b 0

:decl_2
set /a POS+=1
set "WANT="
if not "%TARGET%"=="0" goto :want_hub
if "%NARGS%"=="0" set "WANT=1"
if defined ARGSET_%D_NAME% set "WANT=1"
goto :want_done
:want_hub
if "%POS%"=="%TARGET%" set "WANT=1"
:want_done
if not defined WANT exit /b 0
if "%D_KIND%"=="pinned" goto :n_pinned
if "%D_MAIN%"=="true" goto :sel_add
if "%D_KIND%"=="project" goto :n_project
if "%D_KIND%"=="index" goto :n_index
:sel_add
set "SEL_%D_NAME%=1"
set "ANYSEL=1"
exit /b 0
:n_pinned
>&2 echo rules_ocx: %D_NAME%: pinned by digest in MODULE.bazel; edit the identifier to move it
exit /b 0
:n_project
>&2 echo rules_ocx: %D_NAME%: its ocx.lock is not in this workspace; update it in the module that holds it
exit /b 0
:n_index
>&2 echo rules_ocx: %D_NAME%: its index snapshot is not in this workspace; update it in the module that holds it
exit /b 0

:decl_3
set /a POS+=1
if not defined SEL_%D_NAME% exit /b 0
if "%D_KIND%"=="project" goto :project_step
if "%D_KIND%"=="index" goto :index_step
goto :add_name

:add_name
if defined NAMES goto :add_more
set "NAMES=%D_NAME%"
exit /b 0
:add_more
set "NAMES=%NAMES%,%D_NAME%"
exit /b 0

rem The write target of project and index, workspace-relative with the plan's "/" turned into "\".
:target_path
set "WRITE=%D_WRITE:/=\%"
set "DEST=%BUILD_WORKSPACE_DIRECTORY%\%WRITE%"
set "LOCKDIR="
for %%I in ("%DEST%") do set "LOCKDIR=%%~dpI"
exit /b 0

rem batch cannot resolve a link, so the write target's real path is never compared with the workspace. Instead each
rem component below the workspace root, the target file included, is tested for a link (symlink or junction), and the
rem first one is refused even if it points back into the workspace: LINK_AT names it, or stays empty. No component below
rem the root is a link exactly when the real path lies below the real root. The loop stops: every pass cuts one segment.
:link_walk
set "LINK_AT="
set "WALK=%BUILD_WORKSPACE_DIRECTORY%"
set "REST=%WRITE%"
:link_walk_next
if not defined REST exit /b 0
rem The first segment through for /f; the rest through a substitution, which returns the text unchanged when it holds no
rem backslash. A `tokens=1*` remainder is not used: with one token left, %%B is never assigned.
for /f "eol=| delims=\" %%A in ("%REST%") do set "SEG=%%A"
set "TAIL=%REST:*\=%"
if "%TAIL%"=="%REST%" set "TAIL="
set "REST=%TAIL%"
set "WALK=%WALK%\%SEG%"
set "ATTR="
for %%I in ("%WALK%") do set "ATTR=%%~aI"
call :is_link
if errorlevel 1 goto :link_walk_next
set "LINK_AT=%WALK%"
exit /b 0

rem Whether ATTR (the attributes of one path) holds the reparse-point flag `l`.
:is_link
if "%ATTR%"=="" exit /b 1
if "%ATTR:l=%"=="%ATTR%" exit /b 1
exit /b 0

:project_step
call :target_path
call :link_walk
if not defined LINK_AT goto :project_copy
if not "%LINK_AT%"=="%DEST%" goto :link_refused
for /f "delims=" %%P in ("%DEST%") do >&2 echo(rules_ocx: %D_NAME%: %%P is a symlink; replace it with the file it points to before updating
if not defined FIRST_REF set "FIRST_REF=78"
exit /b 0
:link_refused
for /f "delims=" %%P in ("%LINK_AT%") do >&2 echo(rules_ocx: %D_NAME%: %%P is a link on the path of the write target; refusing to write through it
if not defined FIRST_REF set "FIRST_REF=78"
exit /b 0
:project_copy
set /a RUNN+=1
set "COPY=%SCRATCH%\p%RUNN%"
mkdir "%COPY%" || goto :project_copy_failed
copy /y /b "%LOCKDIR%ocx.toml" "%COPY%\ocx.toml" >nul || goto :project_copy_failed
if not exist "%DEST%" goto :project_args
copy /y /b "%DEST%" "%COPY%\ocx.lock" >nul || goto :project_copy_failed
:project_args
set "RUNARGS=%D_GARGS%%D_BARGS%"
if defined HUBARGS set "RUNARGS=%UARGS%"
set "RUN_RC=0"
setlocal
call :ocx_env
pushd "%SCRATCH%"
"%OCX%" --project "%COPY%\ocx.toml" update --no-pull %RUNARGS%
set "RUN_RC=%ERRORLEVEL%"
popd
endlocal & set "RUN_RC=%RUN_RC%"
if "%RUN_RC%"=="0" goto :project_publish
call :e6
goto :project_done
:project_publish
fc /b "%COPY%\ocx.lock" "%DEST%" >nul 2>&1 && goto :project_done
set "TMPLOCK=%LOCKDIR%.ocx.lock.%RANDOM%%RANDOM%.tmp"
if exist "%TMPLOCK%" goto :project_publish
copy /y /b "%COPY%\ocx.lock" "%TMPLOCK%" >nul || goto :project_publish_failed
move /y "%TMPLOCK%" "%DEST%" >nul || goto :project_publish_failed
:project_done
goto :add_name
:project_publish_failed
del /q "%TMPLOCK%" >nul 2>&1
for /f "delims=" %%P in ("%DEST%") do >&2 echo(rules_ocx: %D_NAME%: replacing %%P failed
if not defined FIRST_REF set "FIRST_REF=74"
exit /b 0
:project_copy_failed
for /f "delims=" %%P in ("%DEST%") do >&2 echo(rules_ocx: %D_NAME%: cannot copy %%P or its ocx.toml
if not defined FIRST_REF set "FIRST_REF=74"
exit /b 0

:index_step
call :target_path
call :link_walk
if not defined LINK_AT goto :index_run
for /f "delims=" %%P in ("%LINK_AT%") do >&2 echo(rules_ocx: %D_NAME%: %%P is a link on the path of the write target; refusing to write through it
if not defined FIRST_REF set "FIRST_REF=78"
exit /b 0
:index_run
set /a RUNN+=1
set "RUN_RC=0"
setlocal
call :ocx_env
pushd "%SCRATCH%"
"%OCX%" --index "%DEST%" index update "%D_ID%"
set "RUN_RC=%ERRORLEVEL%"
popd
endlocal & set "RUN_RC=%RUN_RC%"
if not "%RUN_RC%"=="0" call :e6
goto :add_name

rem E6 and the first failing ocx code. RUNARGS is the text after "ocx" in the message.
:e6
if "%D_KIND%"=="project" set "SHOWN=--project %COPY%\ocx.toml update --no-pull %RUNARGS%"
if "%D_KIND%"=="index" set "SHOWN=--index %DEST% index update %D_ID%"
for /f "delims=" %%P in ("%SHOWN%") do >&2 echo(rules_ocx: %D_NAME%: ocx %%P failed (exit %RUN_RC%)
if not defined FIRST_OCX set "FIRST_OCX=%RUN_RC%"
exit /b 0

rem The environment of one ocx run: a fresh OCX_HOME, the pinned rows, the policy pair, the tag's config and no_config.
rem A pinned row with an empty value is unset: `set "KEY="` is ocx's documented spelling of unset.
:ocx_env
set "OCX_HOME=%SCRATCH%\h%RUNN%"
mkdir "%OCX_HOME%"
@PINNED_ENV@
if not "%D_NOCFG%"=="true" goto :ocx_env_config
@HERMETIC_ENV@
set "OCX_NO_CONFIG=1"
:ocx_env_config
if defined D_CONFIG set "OCX_CONFIG=%D_CONFIG%"
if defined D_ROOT set "OCX_SIGSTORE_TRUSTED_ROOT=%D_ROOT%"
set "OCX_NO_VERIFY=0"
if "%D_UNVER%"=="true" set "OCX_NO_VERIFY=1"
set "OCX_ALLOW_YANKED=0"
if "%D_YANKED%"=="true" set "OCX_ALLOW_YANKED=1"
exit /b 0
