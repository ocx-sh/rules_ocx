#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 The OCX Authors
# Kind: INST (an executed script, POSIX sh; started by `bazel run`)
# Exit: 0 done or nothing to move; 64 usage (E1 E2 E3 E9); 70 plan unreadable; 74 an io failure; 75 Bazel output base
#   locked (E11); 78 no bazel (E8) or a refused write target (E12 E14); else the exit code of the first failing ocx
#   run, else of the nested bazel call.
#
# Generated by ocx_update_repo. It reads every declaration value from plan.txt at run time, so no value from
# MODULE.bazel is program text; the only values filled in below are two absolute paths, a target index and the
# pinned env rows. Run it with `bazel run`, never by hand: BUILD_WORKSPACE_DIRECTORY must name the workspace.
set -u

plan=@PLAN@
ocx=@OCX@
target_index=@TARGET@

nl='
'
ws=
ws_real=
bazel=
scratch=
lock_tmp=
known_nl=
known_comma=
sel=
names=
pos=0
run_n=0
first_ocx=0
first_refusal=0

say() {
  printf '%s\n' "$1" >&2
}

die() {
  say "$2"
  exit "$1"
}

die_plan() {
  die 70 'rules_ocx: internal error: plan.txt ends inside a declaration'
}

# shellcheck disable=SC2329 # reached through on_exit, which only the EXIT trap runs
cleanup() {
  if [ -n "$lock_tmp" ]; then rm -f "$lock_tmp"; fi
  if [ -n "$scratch" ]; then rm -rf "$scratch"; fi
}

# shellcheck disable=SC2329 # run by the EXIT trap below
on_exit() {
  rc=$?
  trap - EXIT
  cleanup
  exit "$rc"
}

trap on_exit EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# The pinned rows of OCX_ENV_CLASSES: a fixed value on every ocx run, never the ambient one.
pinned_env() {
@PINNED_ENV@
}

# The rows `no_config` blanks: OCX_NO_CONFIG alone does not prune an inherited OCX_CONFIG.
hermetic_env() {
@HERMETIC_ENV@
}

# One list of the plan (a count line, then that many lines) into `list`, one value per line.
read_list() {
  list=
  IFS= read -r list_n <&3 || die_plan
  case $list_n in '' | *[!0-9]*) die_plan ;; esac
  while [ "$list_n" -gt 0 ]; do
    IFS= read -r list_v <&3 || die_plan
    list="$list$list_v$nl"
    list_n=$((list_n - 1))
  done
}

# The next declaration of the plan on fd 3 into the d_* variables; status 1 at the end of the plan.
read_decl() {
  IFS= read -r d_name <&3 || return 1
  IFS= read -r d_kind <&3 || die_plan
  IFS= read -r d_main <&3 || die_plan
  IFS= read -r d_write <&3 || die_plan
  IFS= read -r d_id <&3 || die_plan
  IFS= read -r d_config <&3 || die_plan
  IFS= read -r d_no_config <&3 || die_plan
  IFS= read -r d_unverified <&3 || die_plan
  IFS= read -r d_yanked <&3 || die_plan
  IFS= read -r d_root <&3 || die_plan
  read_list
  d_groups=$list
  read_list
  d_bindings=$list
}

is_known() {
  case $1 in '' | *"$nl"*) return 1 ;; esac
  case "$nl$known_nl" in *"$nl$1$nl"*) return 0 ;; esac
  return 1
}

refuse() {
  if [ "$first_refusal" -eq 0 ]; then first_refusal=$1; fi
}

real_path() {
  # userland-ok: realpath first, then readlink -f (GNU, busybox, macOS 12.3 and later); a miss is the E12 refusal
  realpath "$1" 2>/dev/null || readlink -f "$1" 2>/dev/null
}

# Status 0 when the real path of $1 lies inside the workspace; else E12, the refusal is recorded, status 1.
check_target() {
  chk_real=$(real_path "$1") || chk_real=
  if [ -n "$chk_real" ]; then
    if [ "$ws_real" = / ]; then return 0; fi
    case $chk_real in "$ws_real"/*) return 0 ;; esac
  fi
  say "rules_ocx: $d_name: $1 resolves outside the workspace; refusing to write it"
  refuse 78
  return 1
}

# The sh form of one `ocx` run: a fresh OCX_HOME, the pinned rows, the policy pair, the tag's config and no_config.
run_ocx() {
  run_name=$1
  run_bin=$2
  shift 2
  run_n=$((run_n + 1))
  run_home="$scratch/h$run_n"
  run_rc=0
  if mkdir "$run_home"; then
    (
      cd "$scratch" || exit 74
      export OCX_HOME="$run_home"
      pinned_env
      if [ "$d_no_config" = true ]; then
        hermetic_env
        export OCX_NO_CONFIG=1
      fi
      if [ -n "$d_config" ]; then export OCX_CONFIG="$d_config"; fi
      if [ -n "$d_root" ]; then export OCX_SIGSTORE_TRUSTED_ROOT="$d_root"; fi
      if [ "$d_unverified" = true ]; then export OCX_NO_VERIFY=1; else export OCX_NO_VERIFY=0; fi
      if [ "$d_yanked" = true ]; then export OCX_ALLOW_YANKED=1; else export OCX_ALLOW_YANKED=0; fi
      exec "$run_bin" "$@"
    ) </dev/null 3<&- || run_rc=$?
  else
    run_rc=74
  fi
  if [ "$run_rc" -ne 0 ]; then
    say "rules_ocx: $run_name: ocx $* failed (exit $run_rc)"
    if [ "$first_ocx" -eq 0 ]; then first_ocx=$run_rc; fi
  fi
}

add_name() {
  if [ -z "$names" ]; then names=$d_name; else names="$names,$d_name"; fi
}

# The new ocx.lock over the workspace one: a unique temporary file in the same directory, the original's mode, one rename.
publish_lock() {
  if [ -f "$2" ] && cmp -s "$1" "$2"; then return 0; fi
  lock_tmp=$(mktemp "${2%/*}/.ocx.lock.XXXXXX") || return 1
  if [ -f "$2" ]; then
    cp -p "$2" "$lock_tmp" || return 1
    if [ -w "$lock_tmp" ]; then
      cat "$1" >"$lock_tmp" || return 1
    else
      chmod u+w "$lock_tmp" && cat "$1" >"$lock_tmp" && chmod u-w "$lock_tmp" || return 1
    fi
  else
    chmod 644 "$lock_tmp" || return 1
    cat "$1" >"$lock_tmp" || return 1
  fi
  mv -f "$lock_tmp" "$2" || return 1
  lock_tmp=
}

# Kind project: update a scratch copy of ocx.toml and ocx.lock, then publish the lock. $1 is `user` or `default`.
project_step() {
  step_mode=$1
  shift
  step_dest="$ws/$d_write"
  check_target "$step_dest" || return 0
  if [ -L "$step_dest" ]; then
    say "rules_ocx: $d_name: $step_dest is a symlink; replace it with the file it points to before updating"
    refuse 78
    return 0
  fi
  step_dir=${step_dest%/*}
  step_copy="$scratch/p$pos"
  if ! mkdir "$step_copy" || ! cp "$step_dir/ocx.toml" "$step_copy/ocx.toml"; then
    say "rules_ocx: $d_name: cannot copy $step_dir/ocx.toml"
    refuse 74
    return 0
  fi
  if [ -e "$step_dest" ] && ! cp "$step_dest" "$step_copy/ocx.lock"; then
    say "rules_ocx: $d_name: cannot copy $step_dest"
    refuse 74
    return 0
  fi
  if [ "$step_mode" = default ]; then
    set --
    while IFS= read -r step_g; do
      if [ -n "$step_g" ]; then set -- "$@" -g "$step_g"; fi
    done <<EOF
$d_groups
EOF
    while IFS= read -r step_b; do
      if [ -n "$step_b" ]; then set -- "$@" "$step_b"; fi
    done <<EOF
$d_bindings
EOF
  fi
  run_ocx "$d_name" "$ocx" --project "$step_copy/ocx.toml" update --no-pull "$@"
  if [ "$run_rc" -eq 0 ] && ! publish_lock "$step_copy/ocx.lock" "$step_dest"; then
    if [ -n "$lock_tmp" ]; then rm -f "$lock_tmp"; fi
    lock_tmp=
    say "rules_ocx: $d_name: replacing $step_dest failed"
    refuse 74
    return 0
  fi
  add_name
}

# Kind index: ocx writes the snapshot directory itself.
index_step() {
  step_dest="$ws/$d_write"
  check_target "$step_dest" || return 0
  run_ocx "$d_name" "$ocx" --index "$step_dest" index update "$d_id"
  add_name
}

main() {
  ws=${BUILD_WORKSPACE_DIRECTORY:-}
  if [ -z "$ws" ]; then die 64 'rules_ocx: run this target with bazel run'; fi
  if [ ! -r "$plan" ]; then die 70 "rules_ocx: internal error: cannot read $plan"; fi

  # Pass 1: the known names, and the target's kind.
  count=0
  target_name=
  target_kind=
  while read_decl; do
    count=$((count + 1))
    known_nl="$known_nl$d_name$nl"
    if [ -z "$known_comma" ]; then known_comma=$d_name; else known_comma="$known_comma, $d_name"; fi
    if [ "$count" -eq "$target_index" ]; then
      target_name=$d_name
      target_kind=$d_kind
    fi
  done 3<"$plan"

  if [ "$target_index" -eq 0 ]; then
    for a in "$@"; do
      case $a in
        -*) die 64 'rules_ocx: @rules_ocx//:update takes declaration names only; pass ocx update arguments to @<name>//:update' ;;
      esac
    done
    for a in "$@"; do
      if ! is_known "$a"; then die 64 "rules_ocx: no ocx declaration is named '$a'; known: $known_comma"; fi
    done
  elif [ "$target_kind" != project ] && [ "$#" -gt 0 ]; then
    die 64 "rules_ocx: '$target_name' is an ocx.package declaration; its update takes no arguments"
  fi
  if [ "$count" -eq 0 ]; then
    say 'rules_ocx: no ocx declarations'
    exit 0
  fi

  # Pass 2: what runs. E4 and E5 are notices, not failures.
  while read_decl; do
    pos=$((pos + 1))
    want=0
    if [ "$target_index" -gt 0 ]; then
      if [ "$pos" -eq "$target_index" ]; then want=1; fi
    elif [ "$#" -eq 0 ]; then
      want=1
    else
      for a in "$@"; do
        if [ "$a" = "$d_name" ]; then want=1; fi
      done
    fi
    if [ "$want" -eq 0 ]; then continue; fi
    if [ "$d_kind" = pinned ]; then
      say "rules_ocx: $d_name: pinned by digest in MODULE.bazel; edit the identifier to move it"
    elif [ "$d_main" != true ] && [ "$d_kind" = project ]; then
      say "rules_ocx: $d_name: its ocx.lock is not in this workspace; update it in the module that holds it"
    elif [ "$d_main" != true ] && [ "$d_kind" = index ]; then
      say "rules_ocx: $d_name: its index snapshot is not in this workspace; update it in the module that holds it"
    else
      sel="$sel$d_name$nl"
    fi
  done 3<"$plan"
  if [ -z "$sel" ]; then exit 0; fi

  # Step 1: a bazel that cannot start must stop the run before anything is written.
  bazel=${RULES_OCX_BAZEL:-bazel}
  if ! command -v "$bazel" >/dev/null 2>&1; then
    die 78 'rules_ocx: no bazel found; put bazel on PATH or set RULES_OCX_BAZEL'
  fi
  pre_rc=0
  (cd "$ws" && "$bazel" --noblock_for_lock info output_base >/dev/null </dev/null) || pre_rc=$?
  if [ "$pre_rc" -eq 9 ]; then
    die 75 'rules_ocx: the Bazel output base is locked (another command, or bazel --batch run); run the update again without --batch'
  elif [ "$pre_rc" -ne 0 ]; then
    die "$pre_rc" "rules_ocx: bazel info output_base failed (exit $pre_rc)"
  fi

  ws_real=$(cd -P "$ws" && pwd -P) || die 74 "rules_ocx: cannot enter $ws"
  scratch=$(mktemp -d "${TMPDIR:-/tmp}/rules_ocx_update.XXXXXX") || die 74 'rules_ocx: cannot create a scratch directory'

  # Step 2: each selected declaration, in name order.
  pos=0
  while read_decl; do
    pos=$((pos + 1))
    case "$nl$sel" in *"$nl$d_name$nl"*) ;; *) continue ;; esac
    case $d_kind in
      project)
        if [ "$target_index" -gt 0 ] && [ "$#" -gt 0 ]; then project_step user "$@"; else project_step default; fi
        ;;
      index) index_step ;;
      *) add_name ;;
    esac
  done 3<"$plan"

  # Step 3: one nested bazel call moves the facts of everything that was selected.
  nested_rc=0
  if [ -n "$names" ]; then
    (cd "$ws" && exec "$bazel" --noblock_for_lock mod deps --lockfile_mode=update "--repo_env=RULES_OCX_UPDATE=$names" </dev/null) || nested_rc=$?
    if [ "$nested_rc" -eq 9 ]; then
      say 'rules_ocx: the Bazel output base is locked (another command, or bazel --batch run); run the update again without --batch'
      nested_rc=75
    elif [ "$nested_rc" -ne 0 ]; then
      say "rules_ocx: bazel mod deps --lockfile_mode=update failed (exit $nested_rc); no fact moved; the ocx.lock and snapshot files written above stay; once the cause is fixed, run bazel mod deps --lockfile_mode=update"
    fi
  fi

  # Step 4: the first failing ocx run, else the first refusal, else the nested call.
  if [ "$first_ocx" -ne 0 ]; then exit "$first_ocx"; fi
  if [ "$first_refusal" -ne 0 ]; then exit "$first_refusal"; fi
  exit "$nested_rc"
}

main "$@"
