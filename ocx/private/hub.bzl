"""The hub repository: one toolchain per platform, one `ocx_tool` per tool name.

The hub names a set repository only inside `toolchain()`, a label analysis
follows only for the platform toolchain resolution selects, so `bazel build`,
`fetch <target>` and `vendor <target>` fetch one set repository.
"""

load(":platforms.bzl", "platform_constraints", "slug")

visibility(["//ocx", "//ocx/tests"])

_MUSL = "@rules_ocx//ocx/constraints:musl"

# Names the hub's BUILD file already owns.
_TOOLCHAIN_PREFIX = "ocx_toolchain_"
_RESERVED_TOOLS = ["toolchain_type", "tool.bzl", "build", "build.bazel"]

def _q(text):
    """A string literal; JSON strings are valid Starlark."""
    return json.encode(text)

def hub_content_error(sets, tools):
    """What stops a hub from being generated (pure).

    Args:
        sets: as in hub_build_content().
        tools: as in hub_build_content().

    Returns:
        error string naming the platform or tool, "" when fine.
    """
    for platform in sets:
        mapped = platform_constraints(platform)
        if mapped.error:
            return mapped.error
    for name in tools:
        if name.lower() in _RESERVED_TOOLS or name.startswith(_TOOLCHAIN_PREFIX):
            return "rules_ocx: a tool named '{}' collides with a target of the generated hub".format(name)
    return ""

def hub_build_content(sets, tools):
    """The hub's BUILD.bazel text.

    Toolchains are listed musl first and named `ocx_toolchain_<nnn>_<slug>`
    so declaration order, name order and registration order agree: a musl
    execution platform matches both a musl and a glibc toolchain and must meet
    the musl one first. `fail()`s on what hub_content_error() reports.

    Args:
        sets: dict platform string -> label string of that platform's
            `ocx_set_toolchain` target.
        tools: sorted tool names.

    Returns:
        BUILD.bazel text.
    """
    error = hub_content_error(sets, tools)
    if error:
        fail(error)
    rows = []
    for platform in sets:
        mapped = platform_constraints(platform)
        rows.append((0 if _MUSL in mapped.constraints else 1, platform, mapped.constraints))
    rows = sorted(rows)

    out = [
        "# Generated by rules_ocx. Register with `register_toolchains(\"@<hub>//:all\")`.",
        "",
        "load(\":tool.bzl\", \"ocx_tool\")",
        "",
        "package(default_visibility = [\"//visibility:public\"])",
        "",
        "toolchain_type(name = \"toolchain_type\")",
        "",
    ]
    for i, (_, platform, constraints) in enumerate(rows):
        out.append("toolchain(")
        out.append("    name = {},".format(_q("{}{}_{}".format(_TOOLCHAIN_PREFIX, ("00" + str(i))[-3:], slug(platform)))))
        out.append("    exec_compatible_with = [")
        out.extend(["        {},".format(_q(c)) for c in constraints])
        out.append("    ],")
        out.append("    toolchain = {},".format(_q(sets[platform])))
        out.append("    toolchain_type = \":toolchain_type\",")
        out.append(")")
        out.append("")
    for name in tools:
        out.append("ocx_tool(")
        out.append("    name = {},".format(_q(name)))
        out.append("    tool = {},".format(_q(name)))
        out.append(")")
        out.append("")
    return "\n".join(out)

def hub_tool_bzl():
    """The hub's `tool.bzl` text: `ocx_tool` bound to the hub's own toolchain type.

    A rule's `toolchains = ["//:toolchain_type"]` resolves against the repository
    that defines the rule, so the rule is made here, in the hub, from a Label
    that resolves in the hub.

    Returns:
        .bzl text.
    """
    return "\n".join([
        "# Generated by rules_ocx.",
        "",
        "load(\"@rules_ocx//ocx:defs.bzl\", \"make_ocx_tool_rule\")",
        "",
        "ocx_tool = make_ocx_tool_rule(Label(\"//:toolchain_type\"))",
        "",
    ])

def hub_platform_error(platforms, available_platforms):
    """Refuses a requested platform the lock cannot serve.

    Nothing is dropped silently: the first unavailable platform is named,
    together with what the lock does offer.

    Args:
        platforms: requested platform strings.
        available_platforms: platforms the lock offers.

    Returns:
        error string naming the platform, "" when fine.
    """
    if not platforms:
        return "rules_ocx: `platforms` is empty; name at least one of {}".format(available_platforms)
    for platform in platforms:
        if platform not in available_platforms:
            return ("rules_ocx: platform '{}' is not served by the lock (available: {}); " +
                    "pick one of them, or lock a leaf for it").format(platform, ", ".join(available_platforms))
    return ""

def _ocx_hub_repo_impl(rctx):
    rctx.file("BUILD.bazel", hub_build_content(rctx.attr.sets, rctx.attr.tools))
    rctx.file("tool.bzl", hub_tool_bzl())

ocx_hub_repo = repository_rule(
    implementation = _ocx_hub_repo_impl,
    doc = """The hub of a vendored tool collection.

Holds one toolchain per platform (each naming that platform's set repository
only inside `toolchain()`), and one `ocx_tool` per tool name. Register it with
`register_toolchains("@<hub>//:all")`.""",
    attrs = {
        "sets": attr.string_dict(doc = "platform -> label of that platform's `ocx_set_toolchain`."),
        "tools": attr.string_list(doc = "Tool names."),
    },
)
