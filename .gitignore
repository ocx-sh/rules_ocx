bazel-*
.bazelrc.user
.ocx_home/
.lycheecache
.task/
__pycache__/
examples/*/MODULE.bazel.lock
e2e/*/MODULE.bazel.lock
# `ocx index update` also writes the whole-registry catalog next to the tag
# roots. Frozen resolution never reads it (the package descriptor carries its
# own physical address), so keep it out of the committed snapshots.
examples/*/index/*/c/
.agents/worktrees/
# Local agent scratch: harness telemetry and MCP server caches.
.claude/state/
.serena/

# Starlight site: dependencies, build output and pages generated from docs/ by site/scripts/port-docs.mjs.
site/node_modules/
site/dist/
site/.astro/
site/.lighthouseci/
site/src/content/docs/
